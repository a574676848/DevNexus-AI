@page "/control-hub"
@using DevNexus.Web.Client.Models
@using System.Text.Json
@inject HttpClient Http
@inject IToastService ToastService

<PageTitle>Control Hub - DevNexus AI</PageTitle>

<div class="control-hub-container" style="padding: 2rem; max-width: 1200px; margin: 0 auto;">
    <FluentLabel Typo="Typography.PageTitle">Control Hub</FluentLabel>
    <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Class="mb-4">
        Manage your AI connections, data sources, and system settings.
    </FluentLabel>

    <div class="grid-layout" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem;">

        <!-- AI Provider Configuration Card -->
        <FluentCard Area="AI" Style="padding: 1.5rem; overflow: visible;">
            <div class="card-header" style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                <FluentIcon Value="@(new Icons.Regular.Size24.Bot())" Color="Color.Accent" />
                <FluentLabel Typo="Typography.H4">AI Provider</FluentLabel>
            </div>

            <EditForm Model="@aiConfig" OnValidSubmit="SaveConfig">
                <DataAnnotationsValidator />

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="15">

                    <!-- Provider Selection -->
                    <div>
                        <FluentLabel Weight="FontWeight.Bold">Provider</FluentLabel>
                        <FluentSelect TOption="string"
                                      Items="@providerNames"
                                      @bind-SelectedOption="@selectedProviderName"
                                      @bind-SelectedOption:after="@OnProviderChanged"
                                      Style="width: 100%; margin-top: 0.25rem;" />
                    </div>

                    <!-- Provider Description -->
                    @if (currentProvider != null && !string.IsNullOrEmpty(currentProvider.Description))
                    {
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size: 0.875rem; margin-top: -8px;">
                            @currentProvider.Description
                        </FluentLabel>
                    }

                    <!-- Endpoint URL -->
                    <FluentTextField Label="Endpoint URL" 
                                     @bind-Value="aiConfig.Endpoint"
                                     Placeholder="@(currentProvider?.DefaultEndpoint ?? "e.g., http://localhost:11434")"
                                     Style="width: 100%;">
                        <FluentLabel Slot="end">
                            @if (!string.IsNullOrEmpty(currentProvider?.DefaultEndpoint))
                            {
                                <FluentButton Appearance="Appearance.Stealth" 
                                              OnClick="UseDefaultEndpoint"
                                              Title="Use default endpoint">
                                    🔄
                                </FluentButton>
                            }
                        </FluentLabel>
                    </FluentTextField>

                    <!-- Model Name -->
                    <FluentTextField Label="Model Name" 
                                     @bind-Value="aiConfig.Model" 
                                     Placeholder="e.g., gpt-4, llama3"
                                     Style="width: 100%;" />

                    <!-- API Key (conditional) -->
                    @if (currentProvider?.RequiresApiKey == true)
                    {
                        <div>
                            <FluentTextField Label="API Key" 
                                             @bind-Value="aiConfig.ApiKey"
                                             TextFieldType="TextFieldType.Password" 
                                             Placeholder="Enter your API key"
                                             Style="width: 100%;" />
                            @if (!string.IsNullOrEmpty(currentProvider?.ApiKeyUrl))
                            {
                                <FluentAnchor Href="@currentProvider.ApiKeyUrl" 
                                              Target="_blank"
                                              Appearance="Appearance.Hypertext"
                                              Style="font-size: 0.875rem; margin-top: 4px; display: inline-block;">
                                    Get API Key →
                                </FluentAnchor>
                            }
                        </div>
                    }

                    <!-- Action Buttons -->
                    <FluentStack Orientation="Orientation.Horizontal" 
                                 HorizontalAlignment="HorizontalAlignment.End"
                                 Class="mt-4">
                        <FluentButton OnClick="TestConnection" 
                                      Appearance="Appearance.Outline"
                                      IconStart="@(new Icons.Regular.Size20.PlugConnected())" 
                                      Loading="@isTesting">
                            Test Connection
                        </FluentButton>
                        <FluentButton Type="ButtonType.Submit" 
                                      Appearance="Appearance.Accent"
                                      IconStart="@(new Icons.Regular.Size20.Save())" 
                                      Loading="@isSaving">
                            Save Configuration
                        </FluentButton>
                    </FluentStack>

                </FluentStack>
            </EditForm>

            <!-- Test Result Message -->
            @if (!string.IsNullOrEmpty(testMessage))
            {
                <div class="mt-3">
                    <FluentMessageBar Intent="@testIntent" AllowDismiss="false">
                        @testMessage
                    </FluentMessageBar>
                </div>
            }
        </FluentCard>

        <!-- Placeholder for other modules -->
        <FluentCard Area="Data" Style="padding: 1.5rem; opacity: 0.6;">
            <div class="card-header" style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                <FluentIcon Value="@(new Icons.Regular.Size24.Database())" />
                <FluentLabel Typo="Typography.H4">Data Sources</FluentLabel>
            </div>
            <p>Coming soon...</p>
        </FluentCard>

    </div>
</div>

@code {
    private AIProviderConfig aiConfig = new();
    private List<AIProviderInfo> providers = new();
    private List<string> providerNames = new();
    private AIProviderInfo? currentProvider;
    private string selectedProviderName = "";
    private bool isSaving = false;
    private bool isTesting = false;
    private string testMessage = "";
    private MessageIntent testIntent = MessageIntent.Info;

    protected override async Task OnInitializedAsync()
    {
        await LoadProviders();
        await LoadConfiguration();
    }

    private async Task LoadProviders()
    {
        try
        {
            var loadedProviders = await Http.GetFromJsonAsync<List<AIProviderInfo>>("api/config/ai/providers");
            if (loadedProviders != null && loadedProviders.Count > 0)
            {
                providers = loadedProviders;
                providerNames = providers.Select(p => p.Name).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading providers: {ex.Message}");
        }
    }

    private async Task LoadConfiguration()
    {
        try
        {
            var configDict = await Http.GetFromJsonAsync<Dictionary<string, string>>("api/config/ai");
            if (configDict != null)
            {
                if (configDict.TryGetValue("AI:Provider", out var p)) aiConfig.Provider = p;
                if (configDict.TryGetValue("AI:Endpoint", out var e)) aiConfig.Endpoint = e;
                if (configDict.TryGetValue("AI:Model", out var m)) aiConfig.Model = m;
                if (configDict.TryGetValue("AI:ApiKey", out var k)) aiConfig.ApiKey = k;
            }

            // Set current provider based on saved config
            UpdateCurrentProvider();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading configuration: {ex.Message}");
        }
    }

    private void UpdateCurrentProvider()
    {
        currentProvider = providers.FirstOrDefault(p => p.Id == aiConfig.Provider);
        selectedProviderName = currentProvider?.Name ?? "";
    }

    private void OnProviderChanged()
    {
        var provider = providers.FirstOrDefault(p => p.Name == selectedProviderName);
        if (provider != null)
        {
            aiConfig.Provider = provider.Id;
            currentProvider = provider;

            // Auto-populate endpoint if available and current endpoint is empty
            if (!string.IsNullOrWhiteSpace(provider.DefaultEndpoint) && string.IsNullOrWhiteSpace(aiConfig.Endpoint))
            {
                aiConfig.Endpoint = provider.DefaultEndpoint;
            }
        }
    }

    private void UseDefaultEndpoint()
    {
        if (!string.IsNullOrWhiteSpace(currentProvider?.DefaultEndpoint))
        {
            aiConfig.Endpoint = currentProvider.DefaultEndpoint;
        }
    }

    private async Task SaveConfig()
    {
        isSaving = true;
        testMessage = "";
        
        try
        {
            var configDict = new Dictionary<string, string>
            {
                ["AI:Provider"] = aiConfig.Provider,
                ["AI:Endpoint"] = aiConfig.Endpoint,
                ["AI:Model"] = aiConfig.Model,
                ["AI:ApiKey"] = aiConfig.ApiKey ?? ""
            };

            var response = await Http.PostAsJsonAsync("api/config/ai", configDict);
            
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Configuration saved successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to save configuration.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task TestConnection()
    {
        isTesting = true;
        testMessage = "";
        
        try
        {
            var configDict = new Dictionary<string, string>
            {
                ["AI:Provider"] = aiConfig.Provider,
                ["AI:Endpoint"] = aiConfig.Endpoint,
                ["AI:Model"] = aiConfig.Model,
                ["AI:ApiKey"] = aiConfig.ApiKey ?? ""
            };

            var response = await Http.PostAsJsonAsync("api/ai/test", configDict);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();
                testMessage = result.GetProperty("message").GetString() ?? "Connected";
                testIntent = MessageIntent.Success;
            }
            else
            {
                testMessage = await response.Content.ReadAsStringAsync();
                testIntent = MessageIntent.Error;
            }
        }
        catch (Exception ex)
        {
            testMessage = ex.Message;
            testIntent = MessageIntent.Error;
        }
        finally
        {
            isTesting = false;
        }
    }
}
