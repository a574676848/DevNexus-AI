<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>DevNexus.Client</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>DevNexus AI</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.devnexus.client</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <DefaultLanguage>zh-cn</DefaultLanguage>
        <NoWarn>$(NoWarn);PRI257;PRI263;PRI249</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(BuildMacCatalyst)' == 'true'">
        <TargetFrameworks>net10.0-maccatalyst</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(BuildMacCatalyst)' != 'true'">
        <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) and !$([MSBuild]::IsOSPlatform('OSX'))">
        <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-maccatalyst</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <WindowsPackageType>None</WindowsPackageType>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <AppxGeneratePrisIgnoreWarnings>true</AppxGeneratePrisIgnoreWarnings>
        <AppxBundle>Never</AppxBundle>
        <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
        <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
        <None Remove="nul" />

        <!-- 彻底禁用对 Monaco Editor 目录的资源检测和 PRI 索引，作为静态内容部署 -->
        <Content Update="wwwroot\**\lib\monaco-editor\**\*">
            <PathResource>false</PathResource>
            <ExcludedFromPriLayout>true</ExcludedFromPriLayout>
            <DeploymentContent>true</DeploymentContent>
            <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- MAUI Core -->
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        
        <!-- SignalR Client (Keep MessagePack for native if needed, but Client is in Shared) -->
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
        
        <!-- SQLite for offline caching -->
        <PackageReference Include="sqlite-net-pcl" />
        <PackageReference Include="SQLitePCLRaw.bundle_green" />
        
        <!-- System Tray Icon (Windows only — H.NotifyIcon 基础包依赖 System.Private.Windows.Core，不可跨平台 AOT) -->
        <PackageReference Include="H.NotifyIcon.Maui" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="DevNexus.Client.Shared.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevNexus.Client.Shared\DevNexus.Client.Shared.csproj" />
        <ProjectReference Include="..\..\common\DevNexus.Shared\DevNexus.Shared.csproj" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <ProjectReference Include="..\DevNexus.Client.Updater\DevNexus.Client.Updater.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

        <PropertyGroup>
                <DevNexusHostPageStyleSheet>DevNexus.Client.styles.css</DevNexusHostPageStyleSheet>
                <DevNexusHostPageBlazorScript>blazor.webview.js</DevNexusHostPageBlazorScript>
                <DevNexusHostPageIconLinks>&lt;link rel="icon" href="data:," /&gt;</DevNexusHostPageIconLinks>
        </PropertyGroup>

        <Import Project="..\DevNexus.Client.Shared\build\DevNexus.Client.HostPage.targets" />


  <Target Name="CopyUpdaterExecutable"
          AfterTargets="Build"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ItemGroup>
      <UpdaterOutputFiles Include="..\DevNexus.Client.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterOutputFiles)"
          DestinationFiles="@(UpdaterOutputFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
