@namespace DevNexus.Client.Shared.Components.Chat

@using DevNexus.Client.Shared.Helpers
@using DevNexus.Shared.Constants
@using DevNexus.Shared.DTOs
@using DevNexus.Client.Shared.Components.Cards

@* 交互卡片渲染器 - 共用组件 *@
@* 用于 MessageList (流式) 和 MessageItem (历史消息) 中渲染交互卡片 *@

<div class="interactive-card-placeholder">
    @RenderCard()
</div>

@code {
    /// <summary>
    /// 交互卡片 Block 数据
    /// </summary>
    [Parameter, EditorRequired] 
    public BlockDto Block { get; set; } = default!;

    /// <summary>
    /// 根据卡片类型渲染对应组件
    /// </summary>
    private RenderFragment RenderCard()
    {
        var cardType = MetadataHelper.GetString(Block.Metadata, ToolBlockMetadataConstants.CardType, ToolBlockMetadataConstants.CardTypeUnknown);

        return cardType switch
        {
            ToolBlockMetadataConstants.CardTypeSearch => @<WebSearchGrid Block="@Block" />,
            ToolBlockMetadataConstants.CardTypeAdvancedSearch => @<AdvancedSearchPanel Block="@Block" />,     // 高级搜索：完整内容与引用卡片
            ToolBlockMetadataConstants.CardTypeWebpage => @<WebpageArtifact Block="@Block" />,                 // 网页阅读：完整网页内容展示
            ToolBlockMetadataConstants.CardTypeFileTask => @<FileTaskCard Block="@Block" />,                  // 文件任务：显示最小任务状态和输入资产
            _ => @<div class="unknown-card">未知卡片类型: @cardType</div>
        };
    }
}
