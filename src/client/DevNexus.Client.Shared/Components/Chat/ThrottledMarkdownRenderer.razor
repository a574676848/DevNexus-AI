@using System.Threading
@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_containerId" class="@ContentClass"></div>

@code {
    /// <summary>
    /// Markdown 内容
    /// </summary>
    [Parameter] public string Content { get; set; } = "";

    /// <summary>
    /// 是否处于流式传输模式
    /// </summary>
    [Parameter] public bool IsStreaming { get; set; }

    /// <summary>
    /// 节流间隔（毫秒），默认 50ms（业界标准 30-60ms，兼顾流畅与性能）
    /// </summary>
    [Parameter] public int ThrottleMs { get; set; } = 50;

    private const int MinimumStreamingFrameMs = 16;
    private const int StreamingRevealFrameMs = 18;
    private readonly string _containerId = $"smd-{Guid.NewGuid():N}";
    private readonly StreamingMarkdownFramePolicy _framePolicy = StreamingMarkdownFramePolicy.Default;
    private string _lastRenderedContent = "";
    private string? _pendingStreamingContent;
    private bool _initialized;
    private bool? _lastRenderedIsStreaming;
    private DateTime _lastStreamingRenderAt = DateTime.MinValue;
    private CancellationTokenSource? _trailingRenderCts;
    private string ContentClass => IsStreaming
        ? "silky-markdown-content silky-markdown-content--streaming markdown-body"
        : "silky-markdown-content markdown-body";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 初始化 JS 渲染器实例
            await JS.InvokeVoidAsync("devnexusSilkyMarkdown.init", _containerId);
            _initialized = true;
        }

        await TryRenderAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized)
        {
            await TryRenderAsync();
        }
    }

    private async Task TryRenderAsync()
    {
        if (!_initialized)
        {
            return;
        }

        if (Content == _lastRenderedContent && IsStreaming == _lastRenderedIsStreaming)
        {
            return;
        }

        if (IsStreaming)
        {
            await RenderStreamingAsync(Content);
            return;
        }

        CancelTrailingRender();
        await RenderContentAsync(Content, isStreaming: false, enhance: true);
    }

    private async Task RenderStreamingAsync(string content)
    {
        _pendingStreamingContent = content;
        var interval = TimeSpan.FromMilliseconds(Math.Max(MinimumStreamingFrameMs, ThrottleMs));
        var elapsed = DateTime.UtcNow - _lastStreamingRenderAt;

        if (elapsed >= interval)
        {
            await RenderNextStreamingFrameAsync(content);
            return;
        }

        ScheduleTrailingRender(interval - elapsed);
    }

    private async Task RenderNextStreamingFrameAsync(string targetContent)
    {
        var frameContent = BuildStreamingFrame(targetContent);
        var reachedTarget = string.Equals(frameContent, targetContent, StringComparison.Ordinal);

        if (reachedTarget)
        {
            _pendingStreamingContent = null;
        }

        await RenderContentAsync(frameContent, isStreaming: true, enhance: false);
        _lastStreamingRenderAt = DateTime.UtcNow;

        if (!reachedTarget)
        {
            _pendingStreamingContent = targetContent;
            ScheduleTrailingRender(TimeSpan.FromMilliseconds(StreamingRevealFrameMs));
        }
    }

    private string BuildStreamingFrame(string targetContent)
    {
        return _framePolicy.BuildNextFrame(_lastRenderedContent, targetContent);
    }

    private void ScheduleTrailingRender(TimeSpan delay)
    {
        CancelTrailingRender();
        _trailingRenderCts = new CancellationTokenSource();
        var token = _trailingRenderCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delay, token);
                if (token.IsCancellationRequested)
                {
                    return;
                }

                var content = _pendingStreamingContent;
                if (string.IsNullOrEmpty(content) || content == _lastRenderedContent)
                {
                    return;
                }

                await InvokeAsync(async () =>
                {
                    await RenderNextStreamingFrameAsync(content);
                });
            }
            catch (OperationCanceledException)
            {
                // 新 token 到达时取消旧尾帧。
            }
        }, token);
    }

    private async Task RenderContentAsync(string content, bool isStreaming, bool enhance)
    {
        try
        {
            await JS.InvokeVoidAsync("devnexusSilkyMarkdown.render", _containerId, content, isStreaming);
            _lastRenderedContent = content;
            _lastRenderedIsStreaming = isStreaming;

            if (enhance)
            {
                await JS.InvokeVoidAsync("devnexusSilkyMarkdown.enhance", _containerId);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[ThrottledMarkdownRenderer] 渲染错误：{ex.Message}");
        }
    }

    private void CancelTrailingRender()
    {
        _trailingRenderCts?.Cancel();
        _trailingRenderCts?.Dispose();
        _trailingRenderCts = null;
    }

    public async ValueTask DisposeAsync()
    {
        CancelTrailingRender();

        if (_initialized)
        {
            try
            {
                await JS.InvokeVoidAsync("devnexusSilkyMarkdown.dispose", _containerId);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[ThrottledMarkdownRenderer] Dispose 错误：{ex.Message}");
            }
        }
    }
}
