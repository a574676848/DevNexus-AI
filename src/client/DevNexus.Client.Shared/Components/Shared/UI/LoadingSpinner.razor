@namespace DevNexus.Client.Shared.Components.Shared

@* 统一加载动画组件 - 极简现代风 *@

<div class="loading-container @SizeClass @(Overlay ? "overlay" : "") @(FullPage ? "fullpage" : "")">
    @if (ShowLogo)
    {
        @* Logo 呼吸效果 *@
        <div class="loading-logo">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="logo-grad-@_instanceId" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#6366F1" />
                        <stop offset="50%" stop-color="#8B5CF6" />
                        <stop offset="100%" stop-color="#A855F7" />
                    </linearGradient>
                    <filter id="logo-glow-@_instanceId" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="1.5" result="coloredBlur"/>
                        <feMerge>
                            <feMergeNode in="coloredBlur"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>
                    </filter>
                </defs>
                
                <!-- 外圈：六边形框架 -->
                <path d="M24 4L42 14V34L24 44L6 34V14L24 4Z" 
                      stroke="url(#logo-grad-@_instanceId)" stroke-width="2" 
                      fill="none" opacity="0.6" />
                
                <!-- 中心核心：发光节点 -->
                <circle cx="24" cy="24" r="6" fill="url(#logo-grad-@_instanceId)" 
                        filter="url(#logo-glow-@_instanceId)" />
                <circle cx="24" cy="24" r="3" fill="white" opacity="0.9" />
                
                <!-- 代码符号 < > -->
                <path d="M14 20L8 24L14 28" stroke="url(#logo-grad-@_instanceId)" stroke-width="2.5" 
                      stroke-linecap="round" stroke-linejoin="round" />
                <path d="M34 20L40 24L34 28" stroke="url(#logo-grad-@_instanceId)" stroke-width="2.5" 
                      stroke-linecap="round" stroke-linejoin="round" />
                
                <!-- 神经连接线 -->
                <line x1="18" y1="24" x2="30" y2="24" stroke="url(#logo-grad-@_instanceId)" stroke-width="2" />
                <line x1="24" y1="12" x2="24" y2="18" stroke="url(#logo-grad-@_instanceId)" stroke-width="2" opacity="0.7" />
                <line x1="24" y1="30" x2="24" y2="36" stroke="url(#logo-grad-@_instanceId)" stroke-width="2" opacity="0.7" />
                
                <!-- 顶部/底部节点 -->
                <circle cx="24" cy="10" r="2" fill="url(#logo-grad-@_instanceId)" opacity="0.8" />
                <circle cx="24" cy="38" r="2" fill="url(#logo-grad-@_instanceId)" opacity="0.8" />
            </svg>
        </div>
    }
    else
    {
        @* 简洁旋转环 *@
        <div class="spinner-ring"></div>
    }

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="loading-text">
            @Message
            @if (ShowDots)
            {
                <div class="loading-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// 加载提示文字
    /// </summary>
    [Parameter]
    public string Message { get; set; } = "";

    /// <summary>
    /// 尺寸: sm, md, lg
    /// </summary>
    [Parameter]
    public string Size { get; set; } = "md";

    /// <summary>
    /// 是否显示 Logo（全页面加载时使用）
    /// </summary>
    [Parameter]
    public bool ShowLogo { get; set; } = false;

    /// <summary>
    /// 是否显示加载点动画
    /// </summary>
    [Parameter]
    public bool ShowDots { get; set; } = true;

    /// <summary>
    /// 是否为覆盖层模式（半透明遮罩）
    /// </summary>
    [Parameter]
    public bool Overlay { get; set; } = false;

    /// <summary>
    /// 是否为全页面加载模式
    /// </summary>
    [Parameter]
    public bool FullPage { get; set; } = false;

    private string SizeClass => $"size-{Size}";
    
    private readonly string _instanceId = Guid.NewGuid().ToString("N")[..8];
}
