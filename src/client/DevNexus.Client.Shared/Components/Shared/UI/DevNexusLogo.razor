@namespace DevNexus.Client.Shared.Components.Shared

@*
    DevNexusLogo.razor
    DevNexus 品牌 Logo 组件
    设计理念：
    - 六边形框架：代表稳定的架构
    - 代码符号 <>：体现 Code-First 开发理念
    - 中心发光节点：代表 AI 智能核心
    - 神经连接线：代表数据流动与 AI 连接
    - 紫蓝渐变：现代科技感配色
*@

<svg width="@Size" height="@Size" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="@CssClass">
    <defs>
        <!-- 主渐变：紫蓝科技色 -->
        <linearGradient id="devnexusGradient-@_instanceId" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6366F1" />
            <stop offset="50%" stop-color="#8B5CF6" />
            <stop offset="100%" stop-color="#A855F7" />
        </linearGradient>
        <!-- 辉光效果 -->
        <filter id="devnexusGlow-@_instanceId" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="@GlowIntensity" result="coloredBlur"/>
            <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
            </feMerge>
        </filter>
    </defs>
    
    <!-- 外圈：六边形框架 -->
    <path d="M24 4L42 14V34L24 44L6 34V14L24 4Z" 
          stroke="url(#devnexusGradient-@_instanceId)" stroke-width="2" 
          fill="none" opacity="0.6" />
    
    <!-- 中心核心：发光节点 -->
    <circle cx="24" cy="24" r="6" fill="url(#devnexusGradient-@_instanceId)" filter="url(#devnexusGlow-@_instanceId)" />
    <circle cx="24" cy="24" r="3" fill="white" opacity="0.9" />
    
    <!-- 代码符号 < > -->
    <path d="M14 20L8 24L14 28" stroke="url(#devnexusGradient-@_instanceId)" stroke-width="2.5" 
          stroke-linecap="round" stroke-linejoin="round" />
    <path d="M34 20L40 24L34 28" stroke="url(#devnexusGradient-@_instanceId)" stroke-width="2.5" 
          stroke-linecap="round" stroke-linejoin="round" />
    
    <!-- 神经连接线 -->
    <line x1="18" y1="24" x2="30" y2="24" stroke="url(#devnexusGradient-@_instanceId)" stroke-width="2" />
    <line x1="24" y1="12" x2="24" y2="18" stroke="url(#devnexusGradient-@_instanceId)" stroke-width="2" opacity="0.7" />
    <line x1="24" y1="30" x2="24" y2="36" stroke="url(#devnexusGradient-@_instanceId)" stroke-width="2" opacity="0.7" />
    
    <!-- 顶部/底部节点 -->
    <circle cx="24" cy="10" r="2" fill="url(#devnexusGradient-@_instanceId)" opacity="0.8" />
    <circle cx="24" cy="38" r="2" fill="url(#devnexusGradient-@_instanceId)" opacity="0.8" />
</svg>

@code {
    /// <summary>
    /// Logo 尺寸 (宽高相同)
    /// </summary>
    [Parameter]
    public int Size { get; set; } = 24;

    /// <summary>
    /// 辉光强度 (blur 标准差)
    /// </summary>
    [Parameter]
    public double GlowIntensity { get; set; } = 1;

    /// <summary>
    /// 额外 CSS 类
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    // 唯一实例 ID，确保多个 Logo 的渐变 ID 不冲突
    private readonly string _instanceId = Guid.NewGuid().ToString("N")[..8];
}
