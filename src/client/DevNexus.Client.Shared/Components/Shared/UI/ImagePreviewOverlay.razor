@namespace DevNexus.Client.Shared.Components.Shared.UI
@using System
@using System.IO
@using DevNexus.Client.Shared.Components.Icons
@inject IImagePreviewService PreviewService
@inject IFileService FileService
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (PreviewService.IsVisible && !string.IsNullOrEmpty(PreviewService.CurrentImageUrl))
{
    <div class="image-preview-overlay" @onclick="Close">
        <div class="preview-dialog" @onclick:stopPropagation>
            <div class="preview-header">
                <h3>图片预览</h3>
                <div class="preview-actions">
                    <button class="action-btn" @onclick="CopyLink" title="复制图片链接">
                        @if (_showCopyFeedback)
                        {
                            <CheckIcon Size="16" />
                            <span class="copy-feedback">已复制!</span>
                        }
                        else
                        {
                            <CopyIcon Size="16" />
                        }
                    </button>
                    <button class="action-btn" @onclick="DownloadImage" title="下载图片">
                        <DownloadIcon Size="16" />
                    </button>
                    <button class="close-btn" @onclick="Close" title="关闭">
                        <XIcon Size="16" />
                    </button>
                </div>
            </div>
            <div class="preview-body">
                <img src="@PreviewService.CurrentImageUrl" alt="图片预览" />
            </div>
        </div>
    </div>
}

@code {
    private bool _showCopyFeedback;

    protected override void OnInitialized()
    {
        PreviewService.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Close()
    {
        _showCopyFeedback = false;
        PreviewService.Close();
    }

    private async Task CopyLink()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", PreviewService.CurrentImageUrl);
            _showCopyFeedback = true;
            StateHasChanged();
            await Task.Delay(2000);
            _showCopyFeedback = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task DownloadImage()
    {
        try
        {
            var suggestedFileName = GetSuggestedFileName(PreviewService.CurrentImageUrl);
            await FileService.DownloadFileWithDialogAsync(PreviewService.CurrentImageUrl!, suggestedFileName);
        }
        catch
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("open", PreviewService.CurrentImageUrl, "_blank");
            }
            catch { }
        }
    }

    private static string GetSuggestedFileName(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return "generated-image.png";
        }

        try
        {
            var uri = new Uri(url, UriKind.RelativeOrAbsolute);
            if (!uri.IsAbsoluteUri)
            {
                return "generated-image.png";
            }

            var fileName = Path.GetFileName(uri.LocalPath);
            return string.IsNullOrWhiteSpace(fileName) ? "generated-image.png" : fileName;
        }
        catch
        {
            return "generated-image.png";
        }
    }

    public void Dispose()
    {
        PreviewService.OnStateChanged -= HandleStateChanged;
    }
}

