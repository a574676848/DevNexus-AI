@* TrendingUpIcon.razor - 趋势上升图标 *@

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" 
     stroke="@Stroke" stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
    <polyline points="17 6 23 6 23 12"></polyline>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string Stroke { get; set; } = "currentColor";
    [Parameter] public string StrokeWidth { get; set; } = "2";
}
