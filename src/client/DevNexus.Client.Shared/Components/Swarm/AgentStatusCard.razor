@using DevNexus.Shared.DTOs.Swarm

<div class="agent-card @(IsActive ? "active" : "") @(StatusMessage.Contains("失败") || StatusMessage.Contains("Error") ? "error" : "") @(IsRecentChange ? "recently-updated" : "")">
    <div class="agent-avatar">
        @if (StatusMessage.Contains("失败") || StatusMessage.Contains("Error"))
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
        }
        
        @if (IsActive && !StatusMessage.Contains("失败") && !StatusMessage.Contains("Error"))
        {
            <div class="pulse-indicator"></div>
        }
    </div>
    
    <div class="agent-info">
        <div class="agent-header">
            <span class="agent-name">@Name</span>
            <span class="agent-role badge">@Role</span>
            <span class="agent-status-chip @(IsActive ? "agent-status-chip--active" : "agent-status-chip--idle")">
                @(IsActive ? "活跃" : "待机")
            </span>
        </div>
        <div class="agent-status-text">
            @StatusMessage
        </div>
    </div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "Agent";
    [Parameter] public string Role { get; set; } = "Assistant";
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public string StatusMessage { get; set; } = "Idle";
    [Parameter] public bool IsRecentChange { get; set; }
}
