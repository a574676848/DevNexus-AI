@page "/not-found"
@layout MainLayout

<div class="not-found-container">
    <div class="not-found-content">
        <div class="error-code">404</div>
        <h1>页面未找到</h1>
        <p>抱歉，您访问的页面不存在或已被移除。</p>
        
        <div class="quick-links">
            <h3>您可以尝试：</h3>
            <a href="/" class="link-item">
                <span class="link-icon">🏠</span>
                <span>返回首页</span>
            </a>
            <a href="/chat" class="link-item">
                <span class="link-icon">💬</span>
                <span>开始对话</span>
            </a>
            <a href="/settings/control-hub" class="link-item">
                <span class="link-icon">⚙️</span>
                <span>控制中心</span>
            </a>
        </div>
    </div>
</div>

<style>
    /* NotFound 页面样式 - Modern Premium 风格 */
    .not-found-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100%;
        padding: 20px;
        background: var(--bg-primary);
    }

    .not-found-content {
        text-align: center;
        max-width: 400px;
        animation: fadeIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* 404 数字 - 高级质感 */
    .error-code {
        font-size: 120px;
        font-weight: 800;
        line-height: 1;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 24px;
        filter: drop-shadow(0 4px 12px rgba(7, 193, 96, 0.2));
    }

    .not-found-content h1 {
        font-size: 24px;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 12px 0;
    }

    .not-found-content > p {
        font-size: 15px;
        color: var(--text-secondary);
        margin: 0 0 40px 0;
        line-height: 1.6;
    }

    /* 快捷链接卡片 - 采用毛玻璃 */
    .quick-links {
        text-align: left;
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: var(--radius-xl);
        padding: 24px;
        box-shadow: var(--shadow-xl), inset 0 1px 1px #ffffff;
    }

    .quick-links h3 {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-placeholder);
        margin: 0 0 16px 0;
    }

    .link-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px 16px;
        margin: 0 -8px 4px;
        border-radius: var(--radius-lg);
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 500;
        transition: all var(--transition-normal);
    }

    .link-item:hover {
        background: #ffffff;
        box-shadow: var(--shadow-md);
        transform: translateX(8px);
        color: var(--brand-green);
    }

    .link-icon {
        font-size: 20px;
        transition: transform 0.3s ease;
    }
    
    .link-item:hover .link-icon {
        transform: scale(1.2) rotate(-10deg);
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>


