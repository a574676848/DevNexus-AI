@page "/analytics/audit"
@using DevNexus.Client.Shared.DTOs
@using DevNexus.Shared.DTOs
@using DevNexus.Shared.DTOs.Auth
@using DevNexus.Client.Shared.Components.Icons
@using Microsoft.Extensions.Logging
@inject IApiService ApiService
@inject ILogger<AuditDashboard> Logger
@inject IJSRuntime JS
@inject IUserStateService UserStateService
@implements IDisposable

<div class="audit-dashboard-page">
    <header class="page-header">
        <h1>
            <BarChartIcon Size="28" Stroke="currentColor" />
            AI 使用与审计看板
        </h1>
        <p class="subtitle">
            @if (IsExternalView)
            {
                <span class="viewing-badge">明细中</span>
            }
            else
            {
                @(IsAdmin ? "查看用户、系统、场景、模型与成本分布" : "查看我的使用、场景分布与最近明细")
            }
        </p>
    </header>

    @if (!IsExternalView)
    {
        <div class="audit-view-switch" role="tablist" aria-label="审计视角切换">
            <button class="@GetViewTabClass(AuditViewMine)" @onclick="() => SwitchAuditView(AuditViewMine)">我的使用</button>
            @if (IsAdmin)
            {
                <button class="@GetViewTabClass(AuditViewSystem)" @onclick="() => SwitchAuditView(AuditViewSystem)">系统总览</button>
                <button class="@GetViewTabClass(AuditViewDetail)" @onclick="() => SwitchAuditView(AuditViewDetail)">审计明细</button>
            }
        </div>
    }

    <div class="date-filter">
        <div class="filter-group">
            <FilterIcon Size="20" Stroke="currentColor" />
            <label>时间范围:</label>
            <select @bind="selectedPeriod" @bind:after="OnPeriodChanged">
                <option value="7">最近 7 天</option>
                <option value="30">最近 30 天</option>
                <option value="90">最近 90 天</option>
                <option value="custom">自定义</option>
            </select>
        </div>
        @if (selectedPeriod == CustomPeriod)
        {
            <div class="filter-group">
                <label>开始日期:</label>
                <input type="date" @bind="startDate" @bind:after="LoadDataAsync" />
            </div>
            <div class="filter-group">
                <label>结束日期:</label>
                <input type="date" @bind="endDate" @bind:after="LoadDataAsync" />
            </div>
        }
        <div class="filter-group">
            <label>主体</label>
            <select @bind="selectedOwnerType" @bind:after="LoadDataAsync">
                <option value="">全部</option>
                <option value="user">用户</option>
                <option value="system">系统</option>
            </select>
        </div>
        <div class="filter-group">
            <label>场景</label>
            <select @bind="selectedSceneCode" @bind:after="LoadDataAsync">
                <option value="">全部</option>
                @foreach (var option in auditDictionary.Scenes)
                {
                    <option value="@option.Code">@option.DisplayName</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label>状态</label>
            <select @bind="selectedStatus" @bind:after="LoadDataAsync">
                <option value="">全部</option>
                <option value="succeeded">成功</option>
                <option value="failed">失败</option>
                <option value="cancelled">已取消</option>
                <option value="timeout">超时</option>
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <LoadingSpinner Message="加载中" Size="md" />
    }
    else if (hasError)
    {
        <!-- 错误状态 -->
        <div class="error-state-container">
            <div class="error-state-card">
                <div class="error-state-icon">
                    <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                </div>
                <h3 class="error-state-title">数据加载失败</h3>
                <p class="error-state-message">@errorMessage</p>
                <button class="retry-button" @onclick="LoadDataAsync">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 4v6h6M23 20v-6h-6" />
                        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15" />
                    </svg>
                    重新加载
                </button>
            </div>
        </div>
    }
    else if (ShowAdminView)
    {
        <!-- 管理员视图 -->
        <AuditDashboard_AdminView
            Stats="@adminStats"
            Dashboard="@adminDashboard"
            ProviderStats="@providerStats"
            UserRanking="@userRanking"
            AllRecords="@allRecords"
            Dictionary="@auditDictionary"
            CurrentPage="@adminCurrentPage"
            OnPreviousPage="@AdminPreviousPage"
            OnNextPage="@AdminNextPage"
            OnUserClick="@HandleUserClick"
            CompactMode="@(selectedAuditView == AuditViewDetail)" />
    }
    else
    {
        <!-- 普通用户视图 -->
        <AuditDashboard_UserView
            Stats="@userStats"
            Records="@userRecords"
            Dictionary="@auditDictionary"
            CurrentPage="@userCurrentPage"
            OnPreviousPage="@UserPreviousPage"
            OnNextPage="@UserNextPage" />
    }
</div>

@if (!IsExternalView)
{
    <!-- 侧滑详情面板 -->
    <UserDetailPanel
        IsVisible="@isDetailPanelVisible"
        UserId="@selectedUserId"
        UserDisplayName="@selectedUserDisplayName"
        StartDate="@startDate"
        EndDate="@endDate"
        OnClose="@CloseDetailPanel" />
}

