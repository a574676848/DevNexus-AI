@page "/settings/system-info"
@using DevNexus.Client.Shared.DTOs
@using DevNexus.Client.Shared.Components.Icons
@inject IClientVersionService ClientVersionService
@inject IApiService ApiService
@inject IRemoteLogService RemoteLog
@inject IJSRuntime JS

<div class="system-info-panel">
    <!-- 页面头部 -->
    <div class="panel-header">
        <div class="header-info">
            <h2 class="panel-title">系统信息</h2>
            <p class="panel-desc">查看系统版本和运行状态</p>
        </div>
        <button class="btn-refresh" @onclick="LoadDataAsync" disabled="@isLoading">
            <RefreshIcon Size="14" />
            <span>刷新</span>
        </button>
    </div>

    @if (isLoading)
    {
        <LoadingSpinner Message="加载中" Size="md" />
    }
    else
    {
        <!-- 健康状态卡片 -->
        <div class="status-card @(health.Status == "Healthy" ? "healthy" : "warning")">
            <div class="status-indicator">
                @if (health.Status == "Healthy")
                {
                    <CheckCircleIcon Size="32" Stroke="#07c160" />
                }
                else
                {
                    <AlertCircleIcon Size="32" Stroke="#f59e0b" />
                }
            </div>
            <div class="status-content">
                <div class="status-title">系统状态: @health.Status</div>
                <div class="status-details">
                    <span>版本: @health.Version</span>
                    <span class="separator">•</span>
                    <span>检查时间: @health.Timestamp.ToString("HH:mm:ss")</span>
                </div>
            </div>
        </div>

        <div class="info-grid">
            <!-- 客户端信息 -->
            <div class="info-section">
                <div class="section-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                        <line x1="12" y1="18" x2="12.01" y2="18"/>
                    </svg>
                    <span>客户端信息</span>
                </div>
                <div class="info-card">
                    <div class="info-row">
                        <span class="info-label">客户端版本</span>
                        <span class="info-value">@GetClientVersion()</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">运行平台</span>
                        <span class="info-value">@GetPlatform()</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">框架版本</span>
                        <span class="info-value mono">.NET @Environment.Version</span>
                    </div>
                </div>
            </div>

            <!-- 服务器信息 (管理员) -->
            @if (serverInfo != null)
            {
                <div class="info-section">
                    <div class="section-header">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                            <line x1="8" y1="21" x2="16" y2="21"/>
                            <line x1="12" y1="17" x2="12" y2="21"/>
                        </svg>
                        <span>服务器信息</span>
                    </div>
                    <div class="info-card">
                        <div class="info-row">
                            <span class="info-label">服务器版本</span>
                            <span class="info-value">@serverInfo.Version</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">运行环境</span>
                            <span class="info-value">@serverInfo.Environment</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">启动时间</span>
                            <span class="info-value">@serverInfo.StartTime.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(serverInfo.DatabaseProvider))
                        {
                            <div class="info-row">
                                <span class="info-label">数据库</span>
                                <span class="info-value">@serverInfo.DatabaseProvider</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(serverInfo.CacheProvider))
                        {
                            <div class="info-row">
                                <span class="info-label">缓存服务</span>
                                <span class="info-value">@serverInfo.CacheProvider</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- 版本更新 -->
            @if (clientVersion != null)
            {
                <div class="info-section">
                    <div class="section-header">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span>版本更新</span>
                    </div>
                    <div class="info-card">
                        <div class="info-row">
                            <span class="info-label">最新版本</span>
                            <span class="info-value version">@clientVersion.LatestVersion</span>
                        </div>
                        @if (clientVersion.ForceUpdate)
                        {
                            <div class="update-alert">
                                <AlertCircleIcon Size="14" />
                                <span>发现强制更新，请立即更新到最新版本</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(clientVersion.ReleaseNotes))
                        {
                            <div class="release-notes">
                                <div class="notes-title">更新说明</div>
                                <p>@clientVersion.ReleaseNotes</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(clientVersion.DownloadUrl))
                        {
                            <a href="@clientVersion.DownloadUrl" class="btn-download" target="_blank">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                    <polyline points="7 10 12 15 17 10"/>
                                    <line x1="12" y1="15" x2="12" y2="3"/>
                                </svg>
                                <span>下载更新</span>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- 关于 -->
            <div class="info-section about-section">
                <div class="section-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="16" x2="12" y2="12"/>
                        <line x1="12" y1="8" x2="12.01" y2="8"/>
                    </svg>
                    <span>关于 DevNexus</span>
                </div>
                <div class="info-card about-card">
                    <p class="about-text">
                        <strong>DevNexus AI</strong> 是一个智能研发辅助平台，基于 .NET 10 + MAUI Blazor Hybrid 构建。
                        支持多种 AI 供应商，提供代码生成、知识问答、代码分析等功能。
                    </p>
                    <div class="about-links">
                        <a href="https://github.com/a574676848/DevNexus-AI" target="_blank" class="about-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                            </svg>
                            <span>文档</span>
                        </a>
                        <a href="https://github.com/a574676848/DevNexus-AI/issues" target="_blank" class="about-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            <span>反馈问题</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private HealthResponseDto health = new();
    private ServerInfoResponseDto? serverInfo;
    private ClientVersionDto? clientVersion;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        error = null; // Clear previous errors
        StateHasChanged();

        try
        {
            var healthTask = ApiService.GetHealthAsync();
            var serverInfoTask = ApiService.GetServerInfoAsync();
            var versionTask = ApiService.GetClientVersionAsync();

            await Task.WhenAll(healthTask, serverInfoTask, versionTask);

            health = await healthTask;
            serverInfo = await serverInfoTask;
            clientVersion = await versionTask;
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "SystemInfo.LoadSystemInfo");
            error = ex.Message;
            health = new HealthResponseDto { Status = "Unknown", Timestamp = DateTime.UtcNow };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetClientVersion()
    {
        return ClientVersionService.CurrentVersion;
    }

    private static string GetPlatform()
    {
#if WINDOWS
        return "Windows";
#elif MACCATALYST
        return "macOS";
#elif IOS
        return "iOS";
#elif ANDROID
        return "Android";
#else
        return Environment.OSVersion.Platform.ToString();
#endif
    }
}
