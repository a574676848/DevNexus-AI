@using DevNexus.Shared.DTOs
@using DevNexus.Shared.Enums
@inject IApiService ApiService
@inject IRemoteLogService RemoteLog
@inject IJSRuntime JS

<div class="provider-panel">
    @if (Providers.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <LLMIcon Size="48" Stroke="#d1d5db" />
            </div>
            <h3 class="empty-title">暂无存储服务</h3>
            <p class="empty-desc">添加 S3、Azure Blob 或其他存储服务来保存文件和资产</p>
            <button class="btn-primary" @onclick="ShowAddDialog">
                <PlusIcon Size="16" />
                <span>添加第一个存储服务</span>
            </button>
        </div>
    }
    else
    {
        <div class="provider-grid">
            @foreach (var provider in Providers)
            {
                <ProviderCard @key="@provider.Id" LogoUrl="@provider.LogoUrl"
                              DefaultLogo="@GetDefaultProviderLogo(provider.Type)"
                              DisplayName="@provider.DisplayName"
                              ProviderTypeName="@GetProviderTypeName(provider.Type)"
                              IsEnabled="@provider.IsEnabled"
                              IsDefault="@provider.IsDefault"
                              OnLogoError="@(() => HandleLogoError(provider.Id))"
                              ShowTestResult="@testResults.ContainsKey(provider.Id)"
                              TestResultSuccess="@(testResults.TryGetValue(provider.Id, out var r) && r.IsValid)"
                              TestResultMessage="@(testResults.TryGetValue(provider.Id, out var rm) ? rm.ErrorMessage : null)"
                              OnDismissTestResult="@(() => DismissTestResult(provider.Id))">
                    <BodyContent>
                        @if (!string.IsNullOrEmpty(provider.BucketName))
                        {
                            <div class="provider-field">
                                <span class="field-label">Bucket</span>
                                <span class="field-value">@provider.BucketName</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(provider.Region))
                        {
                            <div class="provider-field">
                                <span class="field-label">Region</span>
                                <span class="field-value">@provider.Region</span>
                            </div>
                        }
                    </BodyContent>
                    <FooterContent>
                        <button class="btn-secondary btn-icon" 
                                @onclick="() => TestConnection(provider)"
                                disabled="@testingProvider"
                                title="测试连接">
                            @if (testingProviderId == provider.Id)
                            {
                                <span class="spinner-small"></span>
                                <span>测试中</span>
                            }
                            else
                            {
                                <TestIcon Size="14" />
                                <span>测试</span>
                            }
                        </button>
                        <button class="btn-secondary btn-icon" 
                                @onclick="() => ShowEditDialog(provider)"
                                title="编辑">
                            <EditIcon Size="14" />
                            <span>编辑</span>
                        </button>
                        @if (!provider.IsDefault)
                        {
                            <button class="btn-secondary btn-icon" 
                                    @onclick="() => SetAsDefault(provider)"
                                    title="设为默认">
                                <StarIcon Size="14" />
                                <span>设为默认</span>
                            </button>
                        }
                        <button class="btn-danger btn-icon" 
                                @onclick="() => ShowDeleteConfirm(provider)"
                                title="删除">
                            <TrashIcon Size="14" />
                            <span>删除</span>
                        </button>
                    </FooterContent>
                </ProviderCard>
            }

            <div class="add-provider-card" @onclick="ShowAddDialog">
                <div class="add-icon-wrapper">
                    <PlusIcon Size="32" Stroke="#9ca3af" />
                </div>
                <span class="add-text">添加新存储服务</span>
            </div>
        </div>
    }
</div>

@if (showDialog)
{
    <div class="dialog-overlay" @onclick="CloseDialog">
        <div class="dialog-container" @onclick:stopPropagation>
            <div class="dialog-header">
                <h3>添加存储服务</h3>
                <button class="btn-close" @onclick="CloseDialog" title="关闭">×</button>
            </div>
            <div class="dialog-body">
                @* Logo 选择区域 *@
                <div class="form-section">
                    <label class="form-label">存储服务 Logo</label>
                    <LogoSelector @ref="addLogoSelector"
                                  @bind-SelectedLogo="newProviderLogoPreview"
                                  OnMessage="HandleLogoMessage"
                                  InputId="add-storage-provider-logo" />
                </div>

                <div class="form-section">
                    <label class="form-label">存储类型<span class="required">*</span></label>
                    <select class="form-select" @bind="_selectedProviderType" @bind:after="OnProviderTypeChanged">
                        <option value="">请选择存储类型</option>
                        @foreach (var providerType in Enum.GetValues<StorageProviderType>())
                        {
                            <option value="@providerType">@GetProviderTypeName(providerType)</option>
                        }
                    </select>
                </div>

                <div class="form-section">
                    <label class="form-label">显示名称 <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="newProvider.DisplayName"
                           placeholder="例如: 生产 S3" />
                </div>

                <div class="form-section">
                    <label class="form-label">Bucket 名称</label>
                    <input type="text" class="form-input" @bind="newProvider.BucketName"
                           placeholder="my-bucket" />
                </div>

                <div class="form-section">
                    <label class="form-label">Region</label>
                    <input type="text" class="form-input" @bind="newProvider.Region"
                           placeholder="us-east-1" />
                </div>

                <div class="form-section">
                    <label class="form-label">Access Key</label>
                    <input type="password" class="form-input" @bind="newProvider.AccessKeyId"
                           placeholder="Access Key ID" />
                </div>

                <div class="form-section">
                    <label class="form-label">Secret Key</label>
                    <input type="password" class="form-input" @bind="newProvider.SecretAccessKey"
                           placeholder="Secret Access Key" />
                </div>

                <div class="form-section">
                    <label class="form-label">Service URL</label>
                    <input type="text" class="form-input" @bind="newProvider.ServiceUrl"
                           placeholder="例如: https://s3.amazonaws.com" />
                    <span class="form-hint">自定义端点地址，MinIO、S3 兼容服务需要填写</span>
                </div>

                <div class="form-section">
                    <label class="form-label">CDN 域名</label>
                    <input type="text" class="form-input" @bind="newProvider.CdnDomain"
                           placeholder="例如: https://cdn.example.com" />
                    <span class="form-hint">可选：配置用于访问文件的 CDN 域名</span>
                </div>

                <div class="form-section">
                    <label class="form-label">链接过期时间 (秒)</label>
                    <input type="number" class="form-input" @bind="newProvider.PresignedUrlExpirationSeconds"
                           placeholder="3600" />
                    <span class="form-hint">生成的预签名 URL 有效期，默认 3600 秒</span>
                </div>

                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="newProvider.UseHttps" />
                        <span>使用 HTTPS</span>
                    </label>
                </div>

                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="newProvider.ForcePathStyle" />
                        <span>强制路径样式 (Force Path Style)</span>
                    </label>
                    <span class="form-hint">适用于 MinIO 等不支持虚拟主机样式的服务</span>
                </div>

                <div class="form-section">
                    <label class="form-label">优先级</label>
                    <input type="number" class="form-input" @bind="newProvider.Priority"
                           min="1" max="999" placeholder="100" />
                    <span class="form-hint">数字越小优先级越高，默认为 100</span>
                </div>

                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="newProvider.IsEnabled" />
                        <span>启用此存储服务</span>
                    </label>
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn-secondary" @onclick="CloseDialog">取消</button>
                <button class="btn-secondary" @onclick="TestNewProvider" disabled="@isSubmitting">
                    <TestIcon Size="14" />
                    <span>测试连接</span>
                </button>
                <button class="btn-primary" @onclick="CreateProvider" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-small"></span>
                        <span>创建中...</span>
                    }
                    else
                    {
                        <span>创建</span>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(dialogMessage))
            {
                <div class="dialog-message @(dialogSuccess ? "success" : "error")">
                    @if (dialogSuccess)
                    {
                        <CheckCircleIcon Size="16" />
                    }
                    else
                    {
                        <AlertCircleIcon Size="16" />
                    }
                    <span>@dialogMessage</span>
                </div>
            }
        </div>
    </div>
}

@* 编辑对话框 *@
@if (showEditDialog && providerToEdit != null)
{
    <div class="dialog-overlay" @onclick="CloseEditDialog">
        <div class="dialog-container" @onclick:stopPropagation>
            <div class="dialog-header">
                <h3>编辑存储服务</h3>
                <button class="btn-close" @onclick="CloseEditDialog" title="关闭">×</button>
            </div>
            <div class="dialog-body">
                @* Logo 选择区域 *@
                <div class="form-section">
                    <label class="form-label">存储服务 Logo</label>
                    <LogoSelector @ref="editLogoSelector"
                                  @bind-SelectedLogo="editProviderLogoPreview"
                                  OnMessage="HandleEditLogoMessage"
                                  InputId="edit-storage-provider-logo" />
                </div>

                <div class="form-section">
                    <label class="form-label">存储类型</label>
                    <input type="text" class="form-input" value="@GetProviderTypeName(providerToEdit.Type)" disabled />
                </div>

                <div class="form-section">
                    <label class="form-label">显示名称 <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="editProvider.DisplayName"
                           placeholder="例如: 生产 S3" />
                </div>
                <div class="form-section">
                    <label class="form-label">Bucket 名称</label>
                    <input type="text" class="form-input" @bind="editProvider.BucketName"
                           placeholder="my-bucket" />
                </div>

                <div class="form-section">
                    <label class="form-label">Region</label>
                    <input type="text" class="form-input" @bind="editProvider.Region"
                           placeholder="us-east-1" />
                </div>

                <div class="form-section">
                    <label class="form-label">Access Key</label>
                    <input type="password" class="form-input" @bind="editProvider.AccessKeyId"
                           placeholder="留空则不修改" />
                    <span class="form-hint">留空保持原有 Access Key 不变</span>
                </div>

                <div class="form-section">
                    <label class="form-label">Secret Key</label>
                    <input type="password" class="form-input" @bind="editProvider.SecretAccessKey"
                           placeholder="留空则不修改" />
                    <span class="form-hint">留空保持原有 Secret Key 不变</span>
                </div>

                <div class="form-section">
                    <label class="form-label">Service URL</label>
                    <input type="text" class="form-input" @bind="editProvider.ServiceUrl"
                           placeholder="例如: https://s3.amazonaws.com" />
                    <span class="form-hint">自定义端点地址，MinIO、S3 兼容服务需要填写</span>
                </div>

                <div class="form-section">
                    <label class="form-label">CDN 域名</label>
                    <input type="text" class="form-input" @bind="editProvider.CdnDomain"
                           placeholder="例如: https://cdn.example.com" />
                    <span class="form-hint">可选：配置用于访问文件的 CDN 域名</span>
                </div>

                <div class="form-section">
                    <label class="form-label">链接过期时间 (秒)</label>
                    <input type="number" class="form-input" @bind="editProvider.PresignedUrlExpirationSeconds"
                           placeholder="3600" />
                    <span class="form-hint">生成的预签名 URL 有效期</span>
                </div>

                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="editProviderUseHttps" />
                        <span>使用 HTTPS</span>
                    </label>
                </div>

                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="editProviderForcePathStyle" />
                        <span>强制路径样式 (Force Path Style)</span>
                    </label>
                    <span class="form-hint">适用于 MinIO 等不支持虚拟主机样式的服务</span>
                </div>

                <div class="form-section">
                    <label class="form-label">优先级</label>
                    <input type="number" class="form-input" @bind="editPriority"
                           min="1" max="999" placeholder="100" />
                    <span class="form-hint">数字越小优先级越高，默认为 100</span>
                </div>

                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="editProviderIsEnabled" />
                        <span>启用此存储服务</span>
                    </label>
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn-secondary" @onclick="CloseEditDialog">取消</button>
                <button class="btn-primary" @onclick="UpdateProvider" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-small"></span>
                        <span>保存中...</span>
                    }
                    else
                    {
                        <span>保存</span>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(editDialogMessage))
            {
                <div class="dialog-message @(editDialogSuccess ? "success" : "error")">
                    @if (editDialogSuccess)
                    {
                        <CheckCircleIcon Size="16" />
                    }
                    else
                    {
                        <AlertCircleIcon Size="16" />
                    }
                    <span>@editDialogMessage</span>
                </div>
            }
        </div>
    </div>
}

@* 删除确认对话框 *@
<ConfirmDialog @bind-IsVisible="showDeleteConfirm" Title="确认删除" Message="@deleteConfirmMessage" Icon="🗑️"
    IconClass="danger" ConfirmText="删除" ConfirmButtonClass="danger" OnConfirm="ConfirmDelete" />

