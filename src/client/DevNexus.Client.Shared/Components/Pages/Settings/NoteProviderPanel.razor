@using DevNexus.Shared.DTOs
@using DevNexus.Shared.Enums
@using DevNexus.Client.Shared.Components.Icons
@using DevNexus.Client.Shared.Components.Shared
@inject IApiService ApiService
@inject IRemoteLogService RemoteLog
@inject IJSRuntime JS

<div class="provider-panel">
    @if (Providers.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <NoteIcon Size="48" Stroke="#d1d5db" />
            </div>
            <h3 class="empty-title">暂无笔记供应商</h3>
            <p class="empty-desc">添加 Memos、Notion、Obsidian 或自定义供应商来管理笔记</p>
            <button class="btn-primary" @onclick="ShowAddDialog">
                <PlusIcon Size="16" />
                <span>添加第一个供应商</span>
            </button>
        </div>
    }
    else
    {
        <div class="provider-grid">
            @foreach (var provider in Providers)
            {
                <ProviderCard @key="@provider.Id" LogoUrl="@provider.LogoUrl"
                              DefaultLogo="@GetDefaultLogo(provider.Type)"
                              DisplayName="@provider.DisplayName"
                              ProviderTypeName="@GetProviderTypeDisplayName(provider.Type)"
                              IsEnabled="@provider.IsEnabled"
                              IsDefault="@provider.IsDefault"
                              OnLogoError="@(() => HandleLogoError(provider.Id))"
                              ShowTestResult="@testResults.ContainsKey(provider.Id)"
                              TestResultSuccess="@(testResults.TryGetValue(provider.Id, out var r) && r.IsValid)"
                              TestResultMessage="@(testResults.TryGetValue(provider.Id, out var rm) ? rm.ErrorMessage : null)"
                              OnDismissTestResult="@(() => DismissTestResult(provider.Id))">
                    <BodyContent>
                        <div class="provider-field">
                            <span class="field-label">端点</span>
                            <span class="field-value">@(string.IsNullOrEmpty(provider.Endpoint) ? "默认" : provider.Endpoint)</span>
                        </div>
                        @if (provider.LastValidatedAt.HasValue)
                        {
                            <div class="provider-field">
                                <span class="field-label">最后验证</span>
                                <span class="field-value">@provider.LastValidatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        }
                    </BodyContent>
                    <FooterContent>
                        <button class="btn-secondary btn-icon"
                                @onclick="() => TestConnection(provider)"
                                disabled="@testingProvider"
                                title="测试连接">
                            @if (testingProviderId == provider.Id)
                            {
                                <span class="spinner-small"></span>
                                <span>测试中</span>
                            }
                            else
                            {
                                <TestIcon Size="14" />
                                <span>测试</span>
                            }
                        </button>
                        <button class="btn-secondary btn-icon"
                                @onclick="() => ShowEditDialog(provider)"
                                title="编辑">
                            <EditIcon Size="14" />
                            <span>编辑</span>
                        </button>
                        @if (!provider.IsDefault)
                        {
                            <button class="btn-secondary btn-icon"
                                    @onclick="() => SetAsDefault(provider)"
                                    title="设为默认">
                                <StarIcon Size="14" />
                                <span>设为默认</span>
                            </button>
                        }
                        <button class="btn-danger btn-icon"
                                @onclick="() => ShowDeleteConfirm(provider)"
                                title="删除">
                            <TrashIcon Size="14" />
                            <span>删除</span>
                        </button>
                    </FooterContent>
                </ProviderCard>
            }

            <div class="add-provider-card" @onclick="ShowAddDialog">
                <div class="add-icon-wrapper">
                    <PlusIcon Size="32" Stroke="#9ca3af" />
                </div>
                <span class="add-text">添加新供应商</span>
            </div>
        </div>
    }
</div>

@if (showDialog)
{
    <div class="dialog-overlay" @onclick="CloseDialog">
        <div class="dialog-container" @onclick:stopPropagation>
            <div class="dialog-header">
                <h3>添加笔记供应商</h3>
                <button class="btn-close" @onclick="CloseDialog" title="关闭">×</button>
            </div>
            <div class="dialog-body">
                @* Logo 选择区域 *@
                <div class="form-section">
                    <label class="form-label">供应商 Logo</label>
                    <LogoSelector @ref="addLogoSelector"
                                  @bind-SelectedLogo="newProviderLogoPreview"
                                  OnMessage="HandleLogoMessage"
                                  InputId="add-note-provider-logo" />
                </div>

                <div class="form-section">
                    <label class="form-label">供应商类型<span class="required">*</span></label>
                    <select class="form-select" @bind="_selectedProviderType" @bind:after="OnProviderTypeChanged">
                        <option value="">请选择供应商类型</option>
                        @foreach (var providerType in Enum.GetValues<NoteProviderType>())
                        {
                            <option value="@providerType">@GetProviderTypeDisplayName(providerType)</option>
                        }
                    </select>
                </div>

                <div class="form-section">
                    <label class="form-label">显示名称 <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="newProvider.DisplayName"
                           placeholder="例如: 我的 Memos" />
                </div>

                <div class="form-section">
                    <label class="form-label">API 端点 <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="newProvider.Endpoint"
                           placeholder="例如: https://memos.example.com" />
                    <span class="form-hint">填写完整的 API 端点地址</span>
                </div>

                <div class="form-section">
                    <label class="form-label">优先级</label>
                    <input type="number" class="form-input" @bind="newProvider.Priority"
                           min="1" max="999" placeholder="100" />
                    <span class="form-hint">数字越小优先级越高，默认为 100</span>
                </div>

                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="newProvider.IsEnabled" />
                        <span>启用此供应商</span>
                    </label>
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn-secondary" @onclick="CloseDialog">取消</button>
                <button class="btn-secondary" @onclick="TestNewProvider" disabled="@isSubmitting">
                    <TestIcon Size="14" />
                    <span>测试连接</span>
                </button>
                <button class="btn-primary" @onclick="CreateProvider" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-small"></span>
                        <span>创建中..</span>
                    }
                    else
                    {
                        <span>创建</span>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(dialogMessage))
            {
                <div class="dialog-message @(dialogSuccess ? "success" : "error")">
                    @if (dialogSuccess)
                    {
                        <CheckCircleIcon Size="16" />
                    }
                    else
                    {
                        <AlertCircleIcon Size="16" />
                    }
                    <span>@dialogMessage</span>
                </div>
            }
        </div>
    </div>
}

@* 编辑对话框 *@
@if (showEditDialog && providerToEdit != null)
{
    <div class="dialog-overlay" @onclick="CloseEditDialog">
        <div class="dialog-container" @onclick:stopPropagation>
            <div class="dialog-header">
                <h3>编辑笔记供应商</h3>
                <button class="btn-close" @onclick="CloseEditDialog" title="关闭">×</button>
            </div>
            <div class="dialog-body">
                @* Logo 选择区域 *@
                <div class="form-section">
                    <label class="form-label">供应商 Logo</label>
                    <LogoSelector @ref="editLogoSelector"
                                  @bind-SelectedLogo="editProviderLogoPreview"
                                  OnMessage="HandleEditLogoMessage"
                                  InputId="edit-note-provider-logo" />
                </div>

                <div class="form-section">
                    <label class="form-label">供应商类型</label>
                    <input type="text" class="form-input" value="@GetProviderTypeDisplayName(providerToEdit.Type)" disabled />
                </div>

                <div class="form-section">
                    <label class="form-label">显示名称 <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="editProvider.DisplayName"
                           placeholder="例如: 我的 Memos" />
                </div>

                <div class="form-section">
                    <label class="form-label">API 端点</label>
                    <input type="text" class="form-input" @bind="editProvider.Endpoint"
                           placeholder="例如: https://memos.example.com" />
                </div>

                <div class="form-section">
                    <label class="form-label">优先级</label>
                    <input type="number" class="form-input" @bind="editPriority"
                           min="1" max="999" placeholder="100" />
                    <span class="form-hint">数字越小优先级越高，默认为 100</span>
                </div>

                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="editProvider.IsEnabled" />
                        <span>启用此供应商</span>
                    </label>
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn-secondary" @onclick="CloseEditDialog">取消</button>
                <button class="btn-primary" @onclick="UpdateProvider" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-small"></span>
                        <span>保存中..</span>
                    }
                    else
                    {
                        <span>保存</span>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(editDialogMessage))
            {
                <div class="dialog-message @(editDialogSuccess ? "success" : "error")">
                    @if (editDialogSuccess)
                    {
                        <CheckCircleIcon Size="16" />
                    }
                    else
                    {
                        <AlertCircleIcon Size="16" />
                    }
                    <span>@editDialogMessage</span>
                </div>
            }
        </div>
    </div>
}

@* 删除确认对话框 *@
@if (showDeleteConfirm)
{
    <div class="dialog-overlay" @onclick="() => showDeleteConfirm = false">
        <div class="dialog-container dialog-small" @onclick:stopPropagation>
            <div class="dialog-header">
                <h3>确认删除</h3>
                <button class="btn-close" @onclick="() => showDeleteConfirm = false" title="关闭">×</button>
            </div>
            <div class="dialog-body">
                <div class="confirm-content">
                    <div class="confirm-icon danger">
                        <TrashIcon Size="24" />
                    </div>
                    <p class="confirm-message">@deleteConfirmMessage</p>
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn-secondary" @onclick="() => showDeleteConfirm = false">取消</button>
                <button class="btn-danger" @onclick="ConfirmDelete">删除</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public List<NoteProviderResponse> Providers { get; set; } = new();

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private bool showDialog = false;
    private bool showEditDialog = false;
    private bool showDeleteConfirm = false;
    private bool isSubmitting = false;
    private bool testingProvider = false;
    private Guid? testingProviderId;
    private string? dialogMessage;
    private bool dialogSuccess;
    private string? editDialogMessage;
    private bool editDialogSuccess;
    private string deleteConfirmMessage = "";

    private CreateNoteProviderRequest newProvider = new();
    private UpdateNoteProviderRequest editProvider = new();
    private NoteProviderResponse? providerToEdit;
    private NoteProviderResponse? providerToDelete;
    private Dictionary<Guid, ValidateNoteProviderResponse> testResults = new();
    private HashSet<Guid> logoErrorProviders = new();
    private NoteProviderType? _selectedProviderType;

    // Logo selector component references
    private LogoSelector? addLogoSelector;
    private LogoSelector? editLogoSelector;
    private string? newProviderLogoPreview;
    private string? editProviderLogoPreview;

    private int editPriority = 100;

    /// <summary>
    /// 处理 Logo 选择消息（Add 对话框）
    /// </summary>
    private void HandleLogoMessage((string Message, bool Success) msg)
    {
        dialogMessage = msg.Message;
        dialogSuccess = msg.Success;
        if (msg.Success && !string.IsNullOrEmpty(newProviderLogoPreview))
        {
            newProvider.LogoUrl = newProviderLogoPreview;
        }
        StateHasChanged();
    }

    /// <summary>
    /// 处理 Logo 选择消息（Edit 对话框）
    /// </summary>
    private void HandleEditLogoMessage((string Message, bool Success) msg)
    {
        editDialogMessage = msg.Message;
        editDialogSuccess = msg.Success;
        if (msg.Success && !string.IsNullOrEmpty(editProviderLogoPreview))
        {
            editProvider.LogoUrl = editProviderLogoPreview;
        }
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        newProvider = new CreateNoteProviderRequest { IsEnabled = true, Priority = 100 };
        _selectedProviderType = null;
        newProviderLogoPreview = null;
        dialogMessage = null;
        addLogoSelector?.Reset();
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        newProvider = new();
        _selectedProviderType = null;
        newProviderLogoPreview = null;
    }

    private void OnProviderTypeChanged()
    {
        // 绑定 ProviderType 并同步 ProviderId
        if (_selectedProviderType.HasValue)
        {
            newProvider.Type = _selectedProviderType.Value;
            newProvider.ProviderId = GetProviderIdFromType(_selectedProviderType.Value);
            newProviderLogoPreview = GetDefaultLogo(_selectedProviderType.Value);
        }
    }

    /// <summary>
    /// 根据 NoteProviderType 生成 ProviderId
    /// </summary>
    private static string GetProviderIdFromType(NoteProviderType type)
    {
        return type switch
        {
            NoteProviderType.Memos => "memos",
            NoteProviderType.Notion => "notion",
            NoteProviderType.Obsidian => "obsidian",
            NoteProviderType.Custom => "custom",
            _ => "custom"
        };
    }

    /// <summary>
    /// 根据 NoteProviderType 获取显示名称
    /// </summary>
    private static string GetProviderTypeDisplayName(NoteProviderType type)
    {
        return type switch
        {
            NoteProviderType.Memos => "Memos",
            NoteProviderType.Notion => "Notion",
            NoteProviderType.Obsidian => "Obsidian",
            NoteProviderType.Custom => "自定义",
            _ => type.ToString()
        };
    }

    /// <summary>
    /// 根据 NoteProviderType 获取默认 Logo
    /// </summary>
    private static string GetDefaultLogo(NoteProviderType type)
    {
        return type switch
        {
            NoteProviderType.Memos => "/images/providers/memos.svg",
            NoteProviderType.Notion => "/images/providers/notion.svg",
            NoteProviderType.Obsidian => "/images/providers/obsidian.svg",
            NoteProviderType.Custom => "/images/providers/note.svg",
            _ => "/images/providers/note.svg"
        };
    }

    private async Task CreateProvider()
    {
        if (string.IsNullOrEmpty(newProvider.ProviderId) ||
            string.IsNullOrEmpty(newProvider.DisplayName) ||
            string.IsNullOrEmpty(newProvider.Endpoint))
        {
            dialogMessage = "请填写必要字段";
            dialogSuccess = false;
            return;
        }

        isSubmitting = true;
        dialogMessage = null;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrEmpty(newProviderLogoPreview))
            {
                newProvider.LogoUrl = newProviderLogoPreview;
            }

            await ApiService.CreateProviderAsync(newProvider);
            dialogSuccess = true;
            dialogMessage = "供应商创建成功！";
            await Task.Delay(500);
            CloseDialog();
            await OnRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "NoteProviderPanel.CreateProvider");
            var message = ex.Message;
            if (ex is DevNexus.Client.Shared.Services.Exceptions.ApiException apiEx && !string.IsNullOrEmpty(apiEx.ResponseContent))
            {
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.Nodes.JsonObject>(apiEx.ResponseContent);
                    if (errorObj != null && errorObj.TryGetPropertyValue("error", out var errorNode))
                    {
                        message = errorNode?.ToString() ?? message;
                    }
                }
                catch { /* 忽略解析错误 */ }
            }
            dialogMessage = $"创建失败: {message}";
            dialogSuccess = false;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task TestNewProvider()
    {
        if (string.IsNullOrEmpty(newProvider.ProviderId) ||
            string.IsNullOrEmpty(newProvider.Endpoint))
        {
            dialogMessage = "请填写供应商类型和端点";
            dialogSuccess = false;
            return;
        }

        isSubmitting = true;
        dialogMessage = "测试连接中..";
        StateHasChanged();

        try
        {
            var result = await ApiService.TestProviderConnectionAsync(newProvider);
            dialogSuccess = result.IsValid;
            dialogMessage = result.IsValid ? "连接测试成功" : result.ErrorMessage;
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "NoteProviderPanel.TestNewProvider");
            var message = ex.Message;
            if (ex is DevNexus.Client.Shared.Services.Exceptions.ApiException apiEx && !string.IsNullOrEmpty(apiEx.ResponseContent))
            {
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.Nodes.JsonObject>(apiEx.ResponseContent);
                    if (errorObj != null && errorObj.TryGetPropertyValue("error", out var errorNode))
                    {
                        message = errorNode?.ToString() ?? message;
                    }
                }
                catch { /* 忽略解析错误 */ }
            }
            dialogMessage = $"测试失败: {message}";
            dialogSuccess = false;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task TestConnection(NoteProviderResponse provider)
    {
        testingProvider = true;
        testingProviderId = provider.Id;
        testResults.Remove(provider.Id);
        StateHasChanged();

        try
        {
            var result = await ApiService.ValidateProviderAsync(provider.Id);
            testResults[provider.Id] = result;
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "NoteProviderPanel.TestConnection", new() { ["ProviderId"] = provider.Id });
            testResults[provider.Id] = new ValidateNoteProviderResponse { IsValid = false, ErrorMessage = ex.Message };
        }
        finally
        {
            testingProvider = false;
            testingProviderId = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 关闭测试结果显示
    /// </summary>
    private void DismissTestResult(Guid providerId)
    {
        testResults.Remove(providerId);
        StateHasChanged();
    }

    private async Task SetAsDefault(NoteProviderResponse provider)
    {
        try
        {
            await ApiService.SetDefaultProviderAsync(provider.Id);
            await OnRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "NoteProviderPanel.SetAsDefault", new() { ["ProviderId"] = provider.Id });
        }
    }

    private void ShowDeleteConfirm(NoteProviderResponse provider)
    {
        providerToDelete = provider;
        deleteConfirmMessage = $"确定要删除供应商 \"{provider.DisplayName}\" 吗？此操作无法撤销";
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (providerToDelete == null) return;

        try
        {
            await ApiService.DeleteProviderAsync(providerToDelete.Id);
            await OnRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "NoteProviderPanel.ConfirmDelete", new() { ["ProviderId"] = providerToDelete.Id });
        }
        finally
        {
            providerToDelete = null;
            showDeleteConfirm = false;
        }
    }

    private void HandleLogoError(Guid providerId)
    {
        logoErrorProviders.Add(providerId);
    }

    private void ShowEditDialog(NoteProviderResponse provider)
    {
        providerToEdit = provider;
        editProvider = new UpdateNoteProviderRequest
            {
                DisplayName = provider.DisplayName,
                Endpoint = provider.Endpoint,
                IsEnabled = provider.IsEnabled
            };
        editProviderLogoPreview = provider.LogoUrl ?? GetDefaultLogo(provider.Type);
        editDialogMessage = null;
        editLogoSelector?.Reset();
        editPriority = provider.Priority;
        showEditDialog = true;
    }

    private void CloseEditDialog()
    {
        showEditDialog = false;
        providerToEdit = null;
        editProvider = new();
        editProviderLogoPreview = null;
    }

    private async Task UpdateProvider()
    {
        if (providerToEdit == null) return;

        isSubmitting = true;
        editDialogMessage = null;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrEmpty(editProviderLogoPreview))
            {
                editProvider.LogoUrl = editProviderLogoPreview;
            }

            editProvider.Priority = editPriority;
            await ApiService.UpdateProviderAsync(providerToEdit.Id, editProvider);
            editDialogSuccess = true;
            editDialogMessage = "供应商更新成功！";
            await Task.Delay(500);
            CloseEditDialog();
            await OnRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "NoteProviderPanel.UpdateProvider");
            var message = ex.Message;
            if (ex is DevNexus.Client.Shared.Services.Exceptions.ApiException apiEx && !string.IsNullOrEmpty(apiEx.ResponseContent))
            {
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.Nodes.JsonObject>(apiEx.ResponseContent);
                    if (errorObj != null && errorObj.TryGetPropertyValue("error", out var errorNode))
                    {
                        message = errorNode?.ToString() ?? message;
                    }
                }
                catch { /* 忽略解析错误 */ }
            }
            editDialogMessage = $"更新失败: {message}";
            editDialogSuccess = false;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}

