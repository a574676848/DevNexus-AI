@using DevNexus.Shared.DTOs
@using DevNexus.Shared.Enums
@inject IApiService ApiService
@inject IRemoteLogService RemoteLog
@inject IJSRuntime JS

<div class="provider-panel">
    @if (Providers.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <LLMIcon Size="48" Stroke="#d1d5db" />
            </div>
            <h3 class="empty-title">暂无搜索引擎</h3>
            <p class="empty-desc">添加 Brave Search、Google 或其他搜索引擎来启用联网搜索功能</p>
            <button class="btn-primary" @onclick="ShowAddDialog">
                <PlusIcon Size="16" />
                <span>添加第一个搜索引擎</span>
            </button>
        </div>
    }
    else
    {
        <div class="provider-grid">
            @foreach (var provider in Providers)
            {
                <ProviderCard @key="@provider.Id" LogoUrl="@provider.LogoUrl"
                              DefaultLogo="@GetDefaultProviderLogoFromType(provider.Type)"
                              DisplayName="@provider.DisplayName"
                              ProviderTypeName="@GetProviderTypeDisplayName(provider.Type)"
                              IsEnabled="@provider.IsEnabled"
                              IsDefault="@provider.IsDefault"
                              OnLogoError="@(() => HandleLogoError(provider.Id))"
                              ShowTestResult="@testResults.ContainsKey(provider.Id)"
                              TestResultSuccess="@(testResults.TryGetValue(provider.Id, out var r) && r.IsValid)"
                              TestResultMessage="@(testResults.TryGetValue(provider.Id, out var rm) ? rm.ErrorMessage : null)"
                              OnDismissTestResult="@(() => DismissTestResult(provider.Id))">
                    <BodyContent>
                        <div class="provider-field">
                            <span class="field-label">类型</span>
                            <span class="field-value">@GetProviderTypeDisplayName(provider.Type)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(provider.Endpoint))
                        {
                            <div class="provider-field">
                                <span class="field-label">端点</span>
                                <span class="field-value">@provider.Endpoint</span>
                            </div>
                        }
                    </BodyContent>
                    <FooterContent>
                        <button class="btn-secondary btn-icon"
                                @onclick="() => TestConnection(provider)"
                                disabled="@testingProvider"
                                title="测试连接">
                            @if (testingProviderId == provider.Id)
                            {
                                <span class="spinner-small"></span>
                                <span>测试中</span>
                            }
                            else
                            {
                                <TestIcon Size="14" />
                                <span>测试</span>
                            }
                        </button>
                        <button class="btn-secondary btn-icon"
                                @onclick="() => ShowEditDialog(provider)"
                                title="编辑">
                            <EditIcon Size="14" />
                            <span>编辑</span>
                        </button>
@* 移除设为默认按钮 *@
                        <button class="btn-danger btn-icon"
                                @onclick="() => ShowDeleteConfirm(provider)"
                                title="删除">
                            <TrashIcon Size="14" />
                            <span>删除</span>
                        </button>
                    </FooterContent>
                </ProviderCard>
            }

            <div class="add-provider-card" @onclick="ShowAddDialog">
                <div class="add-icon-wrapper">
                    <PlusIcon Size="32" Stroke="#9ca3af" />
                </div>
                <span class="add-text">添加新搜索引擎</span>
            </div>
        </div>
    }
</div>

@if (showDialog)
{
    <div class="dialog-overlay" @onclick="CloseDialog">
        <div class="dialog-container" @onclick:stopPropagation>
            <div class="dialog-header">
                <h3>添加搜索引擎</h3>
                <button class="btn-close" @onclick="CloseDialog" title="关闭">×</button>
            </div>
            <div class="dialog-body">
                @* Logo 选择区域 *@
                <div class="form-section">
                    <label class="form-label">搜索引擎 Logo</label>
                    <LogoSelector @ref="addLogoSelector"
                                  @bind-SelectedLogo="newProviderLogoPreview"
                                  OnMessage="HandleLogoMessage"
                                  InputId="add-search-provider-logo" />
                </div>

                <div class="form-section">
                    <label class="form-label">搜索引擎类型<span class="required">*</span></label>
                    <select class="form-select" @bind="_selectedProviderType" @bind:after="OnProviderTypeChanged">
                        <option value="">请选择搜索引擎类型</option>
                        @foreach (var providerType in Enum.GetValues<SearchProviderType>())
                        {
                            <option value="@providerType">@GetProviderTypeDisplayName(providerType)</option>
                        }
                    </select>
                </div>

                <div class="form-section">
                    <label class="form-label">显示名称 <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="newProvider.DisplayName"
                           placeholder="例如: Brave Search" />
                </div>

                <div class="form-section">
                    <label class="form-label">API Key</label>
                    <input type="password" class="form-input" @bind="newProvider.ApiKey"
                           placeholder="@(newProvider.Type == SearchProviderType.JinaReader ? "Jina Reader 官方需要 Key，本地部署可留空" : "输入 API Key")" />
                </div>

                <div class="form-section">
                    <label class="form-label">API 端点 (Endpoint) <span class="required">@(_selectedProviderType == SearchProviderType.SearXNG ? "*" : "")</span></label>
                    <input type="text" class="form-input" @bind="newProvider.Endpoint"
                           placeholder="例如: http://localhost:5435" />
                    <span class="form-hint">SearXNG、JinaReader 等私有化部署时必须填写</span>
                </div>

                <div class="form-section">
                    <label class="form-label">API Key</label>
                    <input type="password" class="form-input" @bind="newProvider.ApiKey"
                           placeholder="搜索引擎 API Key (如果有)" />
                </div>


                <div class="form-section">
                    <label class="form-label">优先级</label>
                    <input type="number" class="form-input" @bind="newProvider.Priority"
                           min="1" max="999" placeholder="100" />
                    <span class="form-hint">数字越小优先级越高，默认为 100</span>
                </div>

                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="newProvider.IsEnabled" />
                        <span>启用此搜索引擎</span>
                    </label>
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn-secondary" @onclick="CloseDialog">取消</button>
                <button class="btn-secondary" @onclick="TestNewProvider" disabled="@isSubmitting">
                    <TestIcon Size="14" />
                    <span>测试连接</span>
                </button>
                <button class="btn-primary" @onclick="CreateProvider" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-small"></span>
                        <span>创建中...</span>
                    }
                    else
                    {
                        <span>创建</span>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(dialogMessage))
            {
                <div class="dialog-message @(dialogSuccess ? "success" : "error")">
                    @if (dialogSuccess)
                    {
                        <CheckCircleIcon Size="16" />
                    }
                    else
                    {
                        <AlertCircleIcon Size="16" />
                    }
                    <span>@dialogMessage</span>
                </div>
            }
        </div>
    </div>
}

@* 编辑对话框 *@
@if (showEditDialog && providerToEdit != null)
{
    <div class="dialog-overlay" @onclick="CloseEditDialog">
        <div class="dialog-container" @onclick:stopPropagation>
            <div class="dialog-header">
                <h3>编辑搜索引擎</h3>
                <button class="btn-close" @onclick="CloseEditDialog" title="关闭">×</button>
            </div>
            <div class="dialog-body">
                @* Logo 选择区域 *@
                <div class="form-section">
                    <label class="form-label">搜索引擎 Logo</label>
                    <LogoSelector @ref="editLogoSelector"
                                  @bind-SelectedLogo="editProviderLogoPreview"
                                  OnMessage="HandleEditLogoMessage"
                                  InputId="edit-search-provider-logo" />
                </div>

                <div class="form-section">
                    <label class="form-label">搜索引擎类型</label>
                    <input type="text" class="form-input" value="@GetProviderTypeDisplayName(providerToEdit.Type)" disabled />
                </div>

                <div class="form-section">
                    <label class="form-label">显示名称 <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="editProvider.DisplayName"
                           placeholder="例如: Brave Search" />
                </div>

                <div class="form-section">
                    <label class="form-label">API 端点 (Endpoint)</label>
                    <input type="text" class="form-input" @bind="editProvider.Endpoint"
                           placeholder="搜索服务地址" />
                </div>

                <div class="form-section">
                    <label class="form-label">API Key</label>
                    <input type="password" class="form-input" @bind="editProvider.ApiKey"
                           placeholder="留空则不修改" />
                    <span class="form-hint">留空保持原有 API Key 不变</span>
                </div>

                <div class="form-section">
                    <label class="form-label">优先级</label>
                    <input type="number" class="form-input" @bind="editPriority"
                           min="1" max="999" placeholder="100" />
                    <span class="form-hint">数字越小优先级越高，默认为 100</span>
                </div>

                <!-- Search Provider generally doesn't have Endpoint/ModelName but adding IsEnabled is good -->
                <div class="form-section-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" class="form-checkbox" @bind="editProvider.IsEnabled" />
                        <span>启用此搜索引擎</span>
                    </label>
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn-secondary" @onclick="CloseEditDialog">取消</button>
                <button class="btn-primary" @onclick="UpdateProvider" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-small"></span>
                        <span>保存中...</span>
                    }
                    else
                    {
                        <span>保存</span>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(editDialogMessage))
            {
                <div class="dialog-message @(editDialogSuccess ? "success" : "error")">
                    @if (editDialogSuccess)
                    {
                        <CheckCircleIcon Size="16" />
                    }
                    else
                    {
                        <AlertCircleIcon Size="16" />
                    }
                    <span>@editDialogMessage</span>
                </div>
            }
        </div>
    </div>
}

@* 删除确认对话框 *@
<ConfirmDialog @bind-IsVisible="showDeleteConfirm" Title="确认删除" Message="@deleteConfirmMessage" Icon="🗑️"
    IconClass="danger" ConfirmText="删除" ConfirmButtonClass="danger" OnConfirm="ConfirmDelete" />

@code {
    [Parameter]
    public List<SearchProviderResponse> Providers { get; set; } = new();

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private bool showDialog = false;
    private bool showEditDialog = false;
    private bool showDeleteConfirm = false;
    private bool isSubmitting = false;
    private bool testingProvider = false;
    private Guid? testingProviderId;
    private string? editDialogMessage;
    private bool editDialogSuccess;
    private string? dialogMessage;
    private bool dialogSuccess;
    private string deleteConfirmMessage = "";
    private HashSet<Guid> logoErrorProviders = new();
    private SearchProviderType? _selectedProviderType;

    private CreateSearchProviderRequest newProvider = new();
    private UpdateSearchProviderRequest editProvider = new();
    private SearchProviderResponse? providerToEdit;
    private SearchProviderResponse? providerToDelete;
    private Dictionary<Guid, ValidateProviderResponse> testResults = new();

    // Logo selector component references
    private LogoSelector? addLogoSelector;
    private LogoSelector? editLogoSelector;
    private string? newProviderLogoPreview;
    private string? editProviderLogoPreview;
    private int editPriority = 100;

    /// <summary>
    /// 处理 Logo 选择消息（Add 对话框）
    /// </summary>
    private void HandleLogoMessage((string Message, bool Success) msg)
    {
        dialogMessage = msg.Message;
        dialogSuccess = msg.Success;
        if (msg.Success && !string.IsNullOrEmpty(newProviderLogoPreview))
        {
            newProvider.LogoUrl = newProviderLogoPreview;
        }
        StateHasChanged();
    }

    /// <summary>
    /// 处理 Logo 选择消息（Edit 对话框）
    /// </summary>
    private void HandleEditLogoMessage((string Message, bool Success) msg)
    {
        editDialogMessage = msg.Message;
        editDialogSuccess = msg.Success;
        if (msg.Success && !string.IsNullOrEmpty(editProviderLogoPreview))
        {
            editProvider.LogoUrl = editProviderLogoPreview;
        }
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        newProvider = new CreateSearchProviderRequest { IsEnabled = true };
        _selectedProviderType = null;
        newProviderLogoPreview = null;
        dialogMessage = null;
        addLogoSelector?.Reset();
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        newProvider = new();
        _selectedProviderType = null;
        newProviderLogoPreview = null;
    }

    private void OnProviderTypeChanged()
    {
        // 绑定 ProviderType 并同步 ProviderId
        if (_selectedProviderType.HasValue)
        {
            newProvider.Type = _selectedProviderType.Value;
            newProvider.ProviderId = GetProviderIdFromType(_selectedProviderType.Value);
            newProviderLogoPreview = GetDefaultProviderLogoFromType(_selectedProviderType.Value);
        }
    }

    private async Task CreateProvider()
    {
        if (newProvider.Type == SearchProviderType.SearXNG && string.IsNullOrEmpty(newProvider.Endpoint))
        {
            dialogMessage = "请填写必要字段 (SearXNG 必须填写 Endpoint)";
            dialogSuccess = false;
            return;
        }

        isSubmitting = true;
        dialogMessage = null;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrEmpty(newProviderLogoPreview))
            {
                newProvider.LogoUrl = newProviderLogoPreview;
            }
            await ApiService.CreateSearchProviderAsync(newProvider);
            dialogSuccess = true;
            dialogMessage = "搜索引擎创建成功！";
            await Task.Delay(500);
            CloseDialog();
            await OnRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "SearchProviderPanel.CreateProvider");
            dialogMessage = $"创建失败: {ex.Message}";
            dialogSuccess = false;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task TestNewProvider()
    {
        isSubmitting = true;
        dialogMessage = "测试连接中...";
        StateHasChanged();

        try
        {
            var result = await ApiService.TestSearchProviderConnectionAsync(newProvider);
            dialogSuccess = result.IsValid;
            dialogMessage = result.IsValid ? "连接测试成功！" : result.ErrorMessage;
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "SearchProviderPanel.TestNewProvider");
            dialogMessage = $"测试失败: {ex.Message}";
            dialogSuccess = false;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task TestConnection(SearchProviderResponse provider)
    {
        testingProvider = true;
        testingProviderId = provider.Id;
        testResults.Remove(provider.Id);
        StateHasChanged();

        try
        {
            var result = await ApiService.ValidateSearchProviderAsync(provider.Id);
            testResults[provider.Id] = result;
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "SearchProviderPanel.TestConnection", new() { ["ProviderId"] = provider.Id });
            testResults[provider.Id] = new ValidateProviderResponse { IsValid = false, ErrorMessage = ex.Message };
        }
        finally
        {
            testingProvider = false;
            testingProviderId = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 关闭测试结果显示
    /// </summary>
    private void DismissTestResult(Guid providerId)
    {
        testResults.Remove(providerId);
        StateHasChanged();
    }

    /// <summary>
    /// 根据 SearchProviderType 生成 ProviderId
    /// </summary>
    private static string GetProviderIdFromType(SearchProviderType type)
    {
        return type switch
        {
            SearchProviderType.SearXNG => "searxng",
            SearchProviderType.Tavily => "tavily",
            SearchProviderType.JinaReader => "jinareader",
            SearchProviderType.Firecrawl => "firecrawl",
            _ => "searxng"
        };
    }

    /// <summary>
    /// 根据 SearchProviderType 获取显示名称
    /// </summary>
    private static string GetProviderTypeDisplayName(SearchProviderType type)
    {
        return type switch
        {
            SearchProviderType.SearXNG => "SearXNG (元搜索)",
            SearchProviderType.Tavily => "Tavily (AI 搜索)",
            SearchProviderType.JinaReader => "Jina Reader (网页解析)",
            SearchProviderType.Firecrawl => "Firecrawl (强力抓取)",
            _ => type.ToString()
        };
    }

    /// <summary>
    /// 根据 SearchProviderType 获取默认 Logo
    /// </summary>
    private static string GetDefaultProviderLogoFromType(SearchProviderType type)
    {
        return type switch
        {
            SearchProviderType.SearXNG => "/images/providers/searxng.svg",
            SearchProviderType.Tavily => "/images/providers/tavily.svg",
            SearchProviderType.JinaReader => "/images/providers/jinareader.svg",
            SearchProviderType.Firecrawl => "/images/providers/firecrawl.svg",
            _ => "/images/providers/default.svg"
        };
    }

    private void HandleLogoError(Guid providerId)
    {
        logoErrorProviders.Add(providerId);
        // StateHasChanged(); // 移除此处调用，避免触发由 ProviderCard 引起的循环渲染
    }


    private void ShowDeleteConfirm(SearchProviderResponse provider)
    {
        providerToDelete = provider;
        deleteConfirmMessage = $"确定要删除搜索引擎 \"{provider.DisplayName}\" 吗？此操作无法撤销。";
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (providerToDelete == null) return;

        try
        {
            await ApiService.DeleteSearchProviderAsync(providerToDelete.Id);
            await OnRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "SearchProviderPanel.ConfirmDelete", new() { ["ProviderId"] = providerToDelete.Id });
        }
        finally
        {
            providerToDelete = null;
        }
    }

    private void ShowEditDialog(SearchProviderResponse provider)
    {
        providerToEdit = provider;
        editProvider = new UpdateSearchProviderRequest
            {
                DisplayName = provider.DisplayName,
                Endpoint = provider.Endpoint,
                IsEnabled = provider.IsEnabled
            };
        editProviderLogoPreview = provider.LogoUrl ?? GetDefaultProviderLogoFromType(provider.Type);
        editDialogMessage = null;
        editPriority = provider.Priority;
        showEditDialog = true;
    }

    private void CloseEditDialog()
    {
        showEditDialog = false;
        providerToEdit = null;
        editProvider = new();
        editProviderLogoPreview = null;
    }

    private async Task UpdateProvider()
    {
        if (providerToEdit == null) return;

        isSubmitting = true;
        editDialogMessage = null;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrEmpty(editProviderLogoPreview))
            {
                editProvider.LogoUrl = editProviderLogoPreview;
            }
            editProvider.Priority = editPriority;
            await ApiService.UpdateSearchProviderAsync(providerToEdit.Id, editProvider);
            editDialogSuccess = true;
            editDialogMessage = "搜索引擎更新成功！";
            await Task.Delay(500);
            CloseEditDialog();
            await OnRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            await RemoteLog.LogErrorAsync(ex, "SearchProviderPanel.UpdateProvider");
            editDialogMessage = $"更新失败: {ex.Message}";
            editDialogSuccess = false;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void HandleNewLogoPreviewError()
    {
        // 如果预览图片加载失败，回退到默认图标
        if (_selectedProviderType.HasValue)
        {
            newProviderLogoPreview = GetDefaultProviderLogoFromType(_selectedProviderType.Value);
        }
        StateHasChanged();
    }

    private void HandleEditLogoPreviewError()
    {
        // 如果编辑时预览图片加载失败，回退到默认图标
        if (providerToEdit != null)
        {
            editProviderLogoPreview = GetDefaultProviderLogoFromType(providerToEdit.Type);
        }
        StateHasChanged();
    }
}
