@namespace DevNexus.Client.Shared.Components.Cards

@using DevNexus.Client.Shared.Helpers
@using DevNexus.Shared.Constants
@using DevNexus.Shared.DTOs
@using DevNexus.Client.Shared.Components.Icons

@* 💡 WBS-003：笔记创建成功卡片 *@
@* 显示笔记已成功创建的反馈，并提供查看笔记的链接 *@

<div class="note-success-card card">
    <div class="card-header success-header">
        <CheckCircleIcon Size="18" />
        <span class="card-title">@MetadataHelper.GetString(Block.Metadata, ToolBlockMetadataConstants.Title, "笔记已创建")</span>
    </div>
    
    @if (!string.IsNullOrEmpty(MetadataHelper.GetString(Block.Metadata, ToolBlockMetadataConstants.Message)))
    {
        <div class="card-message">
            @MetadataHelper.GetString(Block.Metadata, ToolBlockMetadataConstants.Message)
        </div>
    }

    <div class="card-actions">
        @if (!string.IsNullOrEmpty(MetadataHelper.GetString(Block.Metadata, ToolBlockMetadataConstants.ActionUrl)))
        {
            <a href="@MetadataHelper.GetString(Block.Metadata, ToolBlockMetadataConstants.ActionUrl)" 
               target="_blank" 
               class="btn btn-primary">
                @MetadataHelper.GetString(Block.Metadata, ToolBlockMetadataConstants.ActionText, ToolBlockMetadataConstants.ActionTextViewNote)
                <ExternalLinkIcon Size="12" />
            </a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public BlockDto Block { get; set; } = default!;
}

<style>
.note-success-card {
    border-left: 4px solid var(--color-success);
    background: linear-gradient(135deg, var(--brand-green-lighter) 0%, var(--brand-green-light) 100%);
    padding: 16px;
    border-radius: 8px;
    margin: 12px 0;
}

.note-success-card .success-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
}

.note-success-card .card-icon {
    font-size: 20px;
    display: inline-block;
}

.note-success-card .card-title {
    font-weight: 600;
    color: var(--color-success);
    font-size: 16px;
}

.note-success-card .card-message {
    color: var(--color-success);
    font-size: 14px;
    margin-bottom: 12px;
    padding: 8px 0;
}

.note-success-card .card-actions {
    display: flex;
    gap: 8px;
}

.note-success-card .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
}

.note-success-card .btn-primary {
    background-color: var(--color-success);
    color: white;
}

.note-success-card .btn-primary:hover {
    background-color: var(--brand-green-hover);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
}

.note-success-card .icon {
    font-size: 12px;
}
</style>
