@namespace DevNexus.Client.Shared.Components.Terminal
@using DevNexus.Client.Shared.Abstractions
@using DevNexus.Client.Shared.Components.Icons
@using DevNexus.Client.Shared.Helpers
@using DevNexus.Client.Shared.Models
@inject IApiService ApiService
@inject IChatState ChatState
@inject IJSRuntime JS
@inject ISignalRService SignalR
@inject ToastService ToastService
@implements IAsyncDisposable

<section class="terminal-session-panel" data-ui-scope="terminal-session-panel">
    <div class="terminal-session-panel__header">
        <div class="terminal-session-panel__title-group">
            <div class="terminal-session-panel__eyebrow-row">
                <span class="terminal-session-panel__eyebrow-icon" aria-hidden="true">
                    <ActivityIcon Size="14" Stroke="currentColor" />
                </span>
                <span class="terminal-session-panel__eyebrow">@Eyebrow</span>
            </div>
            <div class="terminal-session-panel__headline-row">
                <strong class="terminal-session-panel__headline">@Title</strong>
                @if (SelectedRecord != null)
                {
                    <span class="terminal-session-panel__status @GetStatusClass(SelectedRecord)">
                        <span class="terminal-session-panel__status-dot"></span>
                        <span>@GetStatusText(SelectedRecord)</span>
                    </span>
                }
            </div>
            @if (SelectedRecord != null && !string.IsNullOrWhiteSpace(SelectedRecord.Command))
            {
                <code class="terminal-session-panel__command" title="@SelectedRecord.Command">@SelectedRecord.Command</code>
            }
        </div>

        <div class="terminal-session-panel__actions">
            @if (ShowOpenInModalButton)
            {
                <button type="button"
                        class="terminal-session-panel__action terminal-session-panel__action--icon"
                        title="放大"
                        aria-label="放大"
                        @onclick="() => OnOpenInModal.InvokeAsync()">
                    <MaximizeIcon Size="14" Stroke="currentColor" />
                </button>
            }
            <button type="button"
                    class="terminal-session-panel__action terminal-session-panel__action--icon"
                    title="@GetCopyOutputLabel()"
                    aria-label="@GetCopyOutputLabel()"
                    @onclick="CopyOutputAsync"
                    disabled="@_isCopyingOutput">
                <CopyIcon Size="14" Stroke="currentColor" />
            </button>
            @if (CanLoadFullOutput())
            {
                <button type="button"
                        class="terminal-session-panel__action"
                        @onclick="LoadFullOutputAsync"
                        disabled="@_isLoadingFullOutput">
                    @GetLoadFullOutputLabel()
                </button>
            }
            @if (CanTerminate())
            {
                <button type="button"
                        class="terminal-session-panel__action terminal-session-panel__action--danger"
                        @onclick="TerminateAsync"
                        disabled="@_isTerminating">
                    @GetTerminateLabel()
                </button>
            }
            @if (CanRollback())
            {
                <button type="button"
                        class="terminal-session-panel__action"
                        @onclick="RollbackAsync"
                        disabled="@_isRollingBack">
                    @GetRollbackLabel()
                </button>
            }
            @if (OnClose.HasDelegate)
            {
                <button type="button"
                        class="terminal-session-panel__action terminal-session-panel__action--icon"
                        title="收起"
                        aria-label="收起"
                        @onclick="() => OnClose.InvokeAsync()">
                    <MinimizeIcon Size="14" Stroke="currentColor" />
                </button>
            }
        </div>
    </div>

    @if (Records.Count > 1)
    {
        <div class="terminal-session-panel__record-list">
            @foreach (var record in Records)
            {
                <button type="button"
                        class="terminal-session-panel__record-chip @(record.RecordId == SelectedRecord?.RecordId ? "is-active" : string.Empty) @GetRecordChipClass(record)"
                        @onclick="() => OnSelectRecord.InvokeAsync(record.RecordId)">
                    <span>@GetRecordChipTitle(record)</span>
                </button>
            }
        </div>
    }

    @if (SelectedRecord == null)
    {
        <div class="terminal-session-panel__empty">暂无终端记录。</div>
    }
    else
    {
        var outputViewport = GetOutputViewport(SelectedRecord);

        <div class="terminal-session-panel__meta">
            @if (!string.IsNullOrWhiteSpace(SelectedRecord.WorkingDirectory))
            {
                <span class="terminal-session-panel__chip">目录 · @SelectedRecord.WorkingDirectory</span>
            }
            @if (SelectedRecord.ExitCode.HasValue)
            {
                <span class="terminal-session-panel__chip">退出码 @SelectedRecord.ExitCode.Value</span>
            }
            @if (SelectedRecord.OutputWasTrimmed)
            {
                <span class="terminal-session-panel__chip terminal-session-panel__chip--warning">早期输出已截断</span>
            }
            @if (SelectedRecord.HasArchivedOutput)
            {
                <span class="terminal-session-panel__chip">完整日志已归档</span>
            }
            @if (!string.IsNullOrWhiteSpace(SelectedRecord.WatchSummary))
            {
                <span class="terminal-session-panel__chip terminal-session-panel__chip--warning">@SelectedRecord.WatchSummary</span>
            }
            @if (!string.IsNullOrWhiteSpace(SelectedRecord.TerminationReason))
            {
                <span class="terminal-session-panel__chip">@GetTerminationReasonText(SelectedRecord.TerminationReason)</span>
            }
            @if (SelectedRecord.WaitingForInput)
            {
                <span class="terminal-session-panel__chip terminal-session-panel__chip--accent">等待输入</span>
            }
            @if (!string.IsNullOrWhiteSpace(GetLatestActivityText(SelectedRecord)))
            {
                <span class="terminal-session-panel__chip">@GetLatestActivityText(SelectedRecord)</span>
            }
            @if (!string.IsNullOrWhiteSpace(GetStartedAtText(SelectedRecord)))
            {
                <span class="terminal-session-panel__chip">@GetStartedAtText(SelectedRecord)</span>
            }
        </div>

        @if (SelectedRecord.WaitingForInput)
        {
            <div class="terminal-session-panel__notice @(_waitingPulseActive ? "terminal-session-panel__notice--emphasized" : string.Empty)">
                <div class="terminal-session-panel__notice-copy">
                    终端等待输入，底部输入框会直接发送。
                </div>
                <div class="terminal-session-panel__notice-actions">
                    <button type="button" class="terminal-session-panel__notice-action" @onclick="FocusComposerAsync">
                        去输入框
                    </button>
                </div>
            </div>
        }
        else if (SelectedRecord.IsFromHistory && !SelectedRecord.IsActive)
        {
            <div class="terminal-session-panel__notice terminal-session-panel__notice--muted">
                <div class="terminal-session-panel__notice-copy">
                    历史记录仅供查看，不接管输入。
                </div>
            </div>
        }

        <div class="terminal-session-panel__output-shell @GetOutputShellClass()">
            <div class="terminal-session-panel__output-topbar">
                <div class="terminal-session-panel__traffic">
                    <span class="terminal-session-panel__traffic-dot"></span>
                    <span class="terminal-session-panel__traffic-dot"></span>
                    <span class="terminal-session-panel__traffic-dot"></span>
                </div>
                <span class="terminal-session-panel__output-label">@GetOutputModeLabel(SelectedRecord)</span>
                @if (!string.IsNullOrEmpty(GetOutputViewportNotice(outputViewport)))
                {
                    <span class="terminal-session-panel__output-viewport">@GetOutputViewportNotice(outputViewport)</span>
                }
            </div>
            <pre @ref="_outputRef" class="terminal-session-panel__output">@outputViewport.Text</pre>
        </div>

        @if (_showScrollButton)
        {
            <button type="button" class="terminal-session-panel__scroll" @onclick="() => ScrollToBottomAsync(force: true)">
                回到底部
            </button>
        }
    }
</section>
