{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "devnexus": "Host=localhost;Port=5432;Database=devnexus;Username=postgres;Password=CHANGE_ME",
    "redis": "localhost:6379",
    "seq": "http://localhost:5341",
    "qdrant": "http://localhost:6333",
    "elasticsearch": "http://localhost:9200"
  },

  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "SessionIndexName": "devnexus-sessions",
    "MessageIndexName": "devnexus-messages",
    "Enabled": true
  },

  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "DevNexus",
    "Audience": "DevNexus",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },

  "Encryption": {},

  "RateLimit": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 100,
      "Window": "00:01:00"
    },
    "Authenticated": {
      "PermitLimit": 1000,
      "Window": "00:01:00"
    },
    "Chat": {
      "PermitLimit": 20,
      "Window": "00:01:00"
    },
    "CodeExecution": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },

  "Monitoring": {
    "EnableDetailedMonitoring": true,
    "TrackProviderUsage": true,
    "TrackTokenConsumption": true,
    "TrackVectorDbSize": true,
    "MetricsCollectionIntervalSeconds": 60,
    "EnablePerformanceProfiling": false,
    "SlowQueryThresholdMs": 1000
  },

  "ScriptExecution": {
    "TimeoutSeconds": 30,
    "EnableDockerIsolation": false,
    "DockerImage": "mcr.microsoft.com/dotnet/sdk:10.0",
    "DockerMemoryLimitMB": 512,
    "DockerCpuLimit": 1.0,
    "AllowedNamespaces": [
      "System",
      "System.Linq",
      "System.Collections.Generic",
      "System.Text",
      "System.Threading.Tasks",
      "System.Math"
    ],
    "BlockedNamespaces": [
      "System.IO.File",
      "System.Diagnostics.Process",
      "System.Reflection",
      "System.Runtime.InteropServices"
    ]
  },

  "CodeRAG": {
    "SimilarityThreshold": 0.7,
    "MaxSearchResults": 10,
    "BatchIndexSize": 100,
    "EnableCache": true,
    "CacheExpirationMinutes": 60
  },

  "Redis": {
    "Enabled": true,
    "InstanceName": "DevNexus"
  },

  "Database": {
    "EnableAutoMigration": true,
    "EnableDetailedLogging": false
  },

  "Seq": {
    "Enabled": true,
    "MinimumLevel": "Information"
  },

  "LLM": {
    "DefaultProvider": "OpenAICompatible",
    "Providers": {
      "OpenAICompatible": {
        "BaseUrl": "https://api.modelscope.cn/v1",
        "Model": "deepseek-ai/DeepSeek-V3.2",
        "ApiKey": "your-api-key-here",
        "MaxTokens": 4096,
        "Temperature": 0.7,
        "TopP": 0.9
      },
      "Gemini": {
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "Model": "gemini-2.0-flash-exp",
        "ApiKey": "your-gemini-api-key-here",
        "MaxTokens": 8192,
        "Temperature": 0.7,
        "TopP": 0.9
      },
      "Kimi": {
        "BaseUrl": "https://api.moonshot.cn/v1",
        "Model": "moonshot-v1-8k",
        "ApiKey": "your-kimi-api-key-here",
        "MaxTokens": 8192,
        "Temperature": 0.7,
        "TopP": 0.9
      },
      "MiniMax": {
        "BaseUrl": "https://api.minimax.chat/v1/text/chatcompletion_v2",
        "Model": "abab6.5s-chat",
        "ApiKey": "your-minimax-api-key-here",
        "GroupId": "your-group-id-here",
        "MaxTokens": 8192,
        "Temperature": 0.7,
        "TopP": 0.9
      }
    }
  },

  "Storage": {
    "Provider": "S3",
    "Local": {
      "RootPath": "wwwroot/uploads",
      "BaseUrl": "/uploads"
    },
    "S3": {
      "AccessKeyId": "your-access-key-id",
      "SecretAccessKey": "your-secret-access-key",
      "ServiceUrl": "https://s3.amazonaws.com",
      "BucketName": "devnexus-files",
      "Region": "us-east-1",
      "ForcePathStyle": false,
      "CdnDomain": "",
      "UseHttps": true,
      "PresignedUrlExpirationSeconds": 3600
    }
  },

  "WebSearch": {
    "DefaultProvider": "Bing"
  },

  "Search": {
    "InitialProviders": []
  },

  "BingSearch": {
    "ApiKey": "YOUR_BING_SEARCH_API_KEY",
    "Endpoint": "https://api.bing.microsoft.com/v7.0/search",
    "DefaultCount": 10,
    "Market": "zh-CN",
    "SafeSearch": "Moderate"
  },

  "GoogleSearch": {
    "ApiKey": "YOUR_GOOGLE_API_KEY",
    "SearchEngineId": "YOUR_SEARCH_ENGINE_ID",
    "Endpoint": "https://www.googleapis.com/customsearch/v1",
    "DefaultCount": 10,
    "Language": "zh-CN",
    "SafeSearch": "medium"
  },

  "Embedding": {
    "DefaultProvider": "Doubao",
    "Providers": {
      "Doubao": {
        "BaseUrl": "https://ark.cn-beijing.volces.com/api/v3",
        "Model": "ep-20241207110547-crwj7",
        "ApiKey": "your-doubao-api-key-here",
        "VectorSize": 1024,
        "TimeoutSeconds": 30,
        "BatchSize": 10
      },
      "OpenAI": {
        "BaseUrl": "https://api.openai.com/v1",
        "Model": "text-embedding-3-small",
        "ApiKey": "your-openai-api-key-here",
        "VectorSize": 1024,
        "TimeoutSeconds": 30,
        "BatchSize": 10
      }
    }
  },

  "Qdrant": {
    "CollectionName": "devnexus_code",
    "VectorSize": 1024,
    "Distance": "Cosine"
  },

  "CliPolicy": {
    "EnforceSafeBins": true,
    "SafeBins": [
      "cat",
      "cd",
      "cp",
      "dir",
      "dotnet",
      "echo",
      "findstr",
      "Get-ChildItem",
      "git",
      "ls",
      "mkdir",
      "move-item",
      "mv",
      "npm",
      "npx",
      "pnpm",
      "pwd",
      "rg",
      "Select-String",
      "type",
      "where"
    ],
    "PermanentAllowedCommandPatterns": [
      "git status",
      "git diff",
      "git log",
      "dotnet build",
      "dotnet test",
      "rg"
    ]
  },

  "CliSandbox": {
    "Mode": "LocalRestricted",
    "ContainerEngineCommand": "docker",
    "PreferredDockerContextName": "default",
    "FallbackDockerContextName": "win99-docker",
    "ContainerImage": "mcr.microsoft.com/dotnet/sdk:10.0",
    "ContainerShell": "/bin/bash",
    "ContainerWorkingDirectory": "/workspace",
    "DisableNetwork": true,
    "MemoryLimitMb": 512,
    "CpuLimit": 1.0
  },

  "ClientVersion": {
    "web": {
      "MinVersion": "1.0.0",
      "RecommendedVersion": "1.0.0",
      "ForceUpdate": false,
      "UpdateUrl": "",
      "ReleaseNotes": "Initial release"
    },
    "ios": {
      "MinVersion": "1.0.0",
      "RecommendedVersion": "1.0.0",
      "ForceUpdate": false,
      "UpdateUrl": "",
      "ReleaseNotes": "Initial release"
    },
    "android": {
      "MinVersion": "1.0.0",
      "RecommendedVersion": "1.0.0",
      "ForceUpdate": false,
      "UpdateUrl": "",
      "ReleaseNotes": "Initial release"
    },
    "desktop": {
      "MinVersion": "1.0.0",
      "RecommendedVersion": "1.0.0",
      "ForceUpdate": false,
      "UpdateUrl": "",
      "ReleaseNotes": "Initial release"
    }
  },

  "Skills": {
    "RootPath": "wwwroot/skills",
    "BuiltInPath": "wwwroot/skills/built-in",
    "CustomPath": "wwwroot/skills/custom",
    "SharedPath": "wwwroot/skills/custom/shared",
    "EnableHotReload": true,
    "Matching": {
      "MaxMatchResults": 3,
      "MinSemanticScore": 0.65,
      "EnableSemanticMatching": false
    },
    "Security": {
      "AllowScriptExecution": true,
      "AllowedRuntimes": [ "pwsh", "python", "node" ],
      "MaxScriptTimeout": 60000,
      "MaxConcurrentScripts": 5,
      "RequireAdminApproval": true
    }
  }
}
