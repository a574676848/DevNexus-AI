{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "DevNexus-SecretKey-For-JWT-Token-Generation-2024-Minimum-32-Chars",
    "Issuer": "DevNexus",
    "Audience": "DevNexus",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "InstanceName": "DevNexus"
  },
  "LLM": {
    "DefaultProvider": "OpenAICompatible",
    "Providers": {
      "OpenAICompatible": {
        "BaseUrl": "https://api.modelscope.cn/v1",
        "Model": "deepseek-ai/DeepSeek-V3.2",
        "ApiKey": "your-api-key-here",
        "MaxTokens": 4096,
        "Temperature": 0.7,
        "TopP": 0.9
      }
    }
  },
  "ClientVersion": {
    "web": {
      "MinVersion": "1.0.0",
      "RecommendedVersion": "1.0.0",
      "ForceUpdate": false,
      "UpdateUrl": "",
      "ReleaseNotes": "Initial release"
    },
    "ios": {
      "MinVersion": "1.0.0",
      "RecommendedVersion": "1.0.0",
      "ForceUpdate": false,
      "UpdateUrl": "https://apps.apple.com/app/devnexus",
      "ReleaseNotes": "Initial release"
    },
    "android": {
      "MinVersion": "1.0.0",
      "RecommendedVersion": "1.0.0",
      "ForceUpdate": false,
      "UpdateUrl": "https://play.google.com/store/apps/details?id=ai.devnexus",
      "ReleaseNotes": "Initial release"
    },
    "desktop": {
      "MinVersion": "1.0.0",
      "RecommendedVersion": "1.0.0",
      "ForceUpdate": false,
      "UpdateUrl": "https://devnexus.ai/download",
      "ReleaseNotes": "Initial release"
    }
  }
}
