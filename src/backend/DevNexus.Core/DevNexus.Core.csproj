<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1603;EXTEXP0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\common\DevNexus.Shared\DevNexus.Shared.csproj" />
    <ProjectReference Include="..\DevNexus.Domain\DevNexus.Domain.csproj" />
    <!-- Infrastructure reference removed for Onion Architecture - DI binding happens in ApiService -->
  </ItemGroup>

  <ItemGroup>
    <!-- Core 保留的依赖 (应用层) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Microsoft.KernelMemory.Abstractions" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Orchestration" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <!-- Semantic Kernel for Plugins -->
    <PackageReference Include="Microsoft.SemanticKernel" />
    <!-- AWSSDK for StorageProviderManagementService S3 validation -->
    <PackageReference Include="AWSSDK.S3" />
    <!-- HTTP Resilience for configuring HttpClient resilience policies -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

</Project>
